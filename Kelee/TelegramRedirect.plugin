#!name=Telegram重定向
#!desc=适用于安装了多个不同Telegram客户端的用户，用于在指定客户端中打开公开或私有群组及频道的Telegram短链。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Telegram.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
request if ${url} ~= /^https:\/\/t\.me\/([A-Za-z][A-Za-z0-9_]{3,30}[A-Za-z0-9])\/?$/ as item then redirect(307, "${app}://resolve?domain=${item.1}")
request if ${url} ~= /^https:\/\/t\.me\/\+([A-Za-z0-9_-]+)\/?$/ as item then redirect(307, "${app}://join?invite=${item.1}")
[MitM]
hostname=t.me
