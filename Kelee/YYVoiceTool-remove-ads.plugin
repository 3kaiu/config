#!name=YY语音去广告
#!desc=移除开屏广告、应用内弹窗、任务推广、频道横幅推广，精简广场顶部标签。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YYVoiceTool.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
^https:\/\/yuyin-api\.baizhanlive\.com\/homepage\/flashscreen\/get\? reject-dict
^https:\/\/yuyin-api\.baizhanlive\.com\/homepage\/homepage\/banner\? reject-dict
^https:\/\/web\.yy\.com\/yyvoice_task_sys\/bar\.html\? reject
^https:\/\/yuyin-api\.baizhanlive\.com\/postsquare\/college\/page\/tabsV3\? response-body-json-jq '.data.tabList |= map(select(.code == "post" or .code == "teamup" or .code == "college" or .code == "aiSecretRoom"))'
^https:\/\/yuyin-api\.baizhanlive\.com\/search\/search\/hotword\? reject-dict
[MitM]
hostname=yuyin-api.baizhanlive.com, web.yy.com
