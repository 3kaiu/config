#!name=多屏互动去广告
#!desc=移除开屏广告、横幅推广、搜索填充词，移除广告下发。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TCLnScreen.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/ads\/ reject-dict
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\/banner$ reject-dict
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/config\/function\? response-body-json-jq '.data |= map(select(.module == "tools"))'
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/searchrank$ reject-dict
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/v\d\/selection\? reject-dict
^https:\/\/tcast-o\.api\.leiniao\.com\/tcast\/message\/v\d\/activity\? reject-dict
[MitM]
hostname=tcast-o.api.leiniao.com
