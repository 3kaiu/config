#!name=Roborock去广告
#!desc=移除横幅、活动推广、机器人图标，精简服务中心。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Roborock.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
^https:\/\/cniot\.roborock\.com\/api\/v1\/activity\/banner\/list$ reject-dict
^https:\/\/cniot\.roborock\.com\/api\/v1\/activity\/latest$ reject-dict
^https:\/\/cniot\.roborock\.com\/api\/v1\/app\/theme\/device\/icon\? reject
^https:\/\/api\.roborock\.com\/v2\/h5\.page\.item\.info\?id=4115$ response-body-json-jq '.data |= map(select(.title == "常用功能"))'
[MitM]
hostname=cniot.roborock.com, api.roborock.com
