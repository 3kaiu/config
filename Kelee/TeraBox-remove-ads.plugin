#!name=TeraBox去广告
#!desc=移除开屏广告、应用内悬浮窗、弹窗广告及横幅广告。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TeraBox.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rule]
DOMAIN, ymg-api.terabox.com, REJECT
[Rewrite]
^https:\/\/www\.terabox\.com\/adx\/ reject-dict
^https:\/\/www\.terabox\.com\/api\/ad\/ reject-dict
^https:\/\/www\.terabox\.com\/api\/page\/tips\? reject-dict
^https:\/\/www\.terabox\.com\/rest\/1\.0\/task\/common\/inttips\? reject-dict
[MitM]
hostname=www.terabox.com
