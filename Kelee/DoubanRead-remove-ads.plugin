#!name=豆瓣阅读去广告
#!desc=移除开屏广告、弹窗广告、热门搜索、热搜榜。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DoubanRead.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
^https:\/\/read\.douban\.com\/api\/v2\/ads\/ reject-dict
^https:\/\/read\.douban\.com\/api\/v2\/popup$ reject-dict
^https:\/\/read\.douban\.com\/api\/v2\/search\/hot_words$ reject-dict
^https:\/\/read\.douban\.com\/api\/v2\/search\/hot_charts$ reject-dict
^https:\/\/read\.douban\.com\/api\/v2\/search\/rec_urls$ reject-dict
[MitM]
hostname=read.douban.com
