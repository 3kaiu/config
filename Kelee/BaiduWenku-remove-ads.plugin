#!name=百度文库去广告
#!desc=移除开屏广告、横幅广告、弹窗广告、信息流推广、搜索发现、热门搜索、资料库搜索推荐，精简我的页面。
#!version=1.0
#!author=3kaiu (基于可莉 iKeLee 插件转写, CC BY-NC-SA)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduWenku.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
^https:\/\/appwk\.baidu\.com\/xpage\/interface\/wknaad\? reject-dict
^https:\/\/appwk\.baidu\.com\/appapi\/index\/home\? response-body-json-del data.bannerInfo data.bannerList data.bannerListV2
^https:\/\/(appwk|tanbi)\.baidu\.com\/gsula\/sula\/syncmrecall$ response-body-json-del data.items
^https:\/\/appwk\.baidu\.com\/appapi\/index\/tab\? response-body-json-del data
^https:\/\/appwk\.baidu\.com\/appapi\/search\/hot\? reject-dict
^https:\/\/appwk\.baidu\.com\/naapi\/search\/wkhotwords\? reject-dict
^https:\/\/appwk\.baidu\.com\/appapi\/forum\/feed\?reqMode=wenkuapp_main_feed response-body-json-del data
^https:\/\/appwk\.baidu\.com\/appapi\/task\/viptasklist\? reject-dict
^https:\/\/appwk\.baidu\.com\/activity\/interface\/wkapppopup\? reject-dict
^https:\/\/appwk\.baidu\.com\/appapi\/abg\/index\? reject-dict
^https:\/\/appwk\.baidu\.com\/naapi\/recommend\/recommenddoc\? reject-dict
^https:\/\/appwk\.baidu\.com\/naapi\/recommend\/vipdoccard\? reject-dict
[MitM]
hostname=appwk.baidu.com, tanbi.baidu.com
