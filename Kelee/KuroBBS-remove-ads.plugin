#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
[Rewrite]
^https:\/\/api\.kurobbs\.com\/config\/getOpenScreen$ reject-dict
^https:\/\/api\.kurobbs\.com\/config\/index\/windows$ reject-dict
^https:\/\/api\.kurobbs\.com\/config\/search\/getSearchConfig\? reject-dict
^https:\/\/api\.kurobbs\.com\/forum\/app\/topic\/hotlist\? reject-dict
[MitM]
hostname=api.kurobbs.com
