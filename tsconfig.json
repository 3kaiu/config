{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["Scripts-src/*"]
    }
  },
  "include": ["Scripts-src/**/*.ts"],
  "exclude": ["node_modules", "Scripts", "Mirror", "dist"]
}
