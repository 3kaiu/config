{
  "name": "3kaiu-config",
  "version": "8.5.0",
  "private": true,
  "description": "3kaiu Loon config v8.5 — Surgio project with TypeScript foundation and optimized structure",
  "scripts": {
    "build": "esbuild $(find src -name '*.ts' ! -name 'env.ts' ! -name 'loon.d.ts') --inject:src/env.ts --outdir=Scripts --minify --target=es2020",
    "generate": "surgio generate --skip-lint",
    "preview": "surgio preview",
    "test": "node test/run-tests.js && node test/rule-order-check.js",
    "lint": "eslint Scripts/ test/ tools/",
    "check:sync": "node tools/tpl-sync-check.mjs",
    "check:orphan": "node tools/mitm-orphan-check.mjs --local",
    "check:plugin": "node tools/plugin-lint-check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "surgio": "3.19.0"
  }
}
