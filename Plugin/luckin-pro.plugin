[Rewrite]
# ── HTTPDNS 拦截 (腾讯 DNSPod HTTPDNS 直连 IP, 主配置 DOMAIN-KEYWORD httpdns 不覆盖字面 IP) ──
^https:\/\/119\.29\.29\.87\/d reject-200

[Script]
# ── 加密响应体净化 (AES-128-ECB 解密 → 清洗 → 重加密) ──
http-response ^https:\/\/capi\.lkcoffee\.com\/resource\/(?:m\/(?:sys\/(?:config\/value|common\/modules|homePage\/(?:common|contactor)\/modules|base\/myPageSectionShow\/newUI|app\/(?:adposNew|carousel)|visual\/effect\/modules)|aigc\/showAIButton)|seckill\/ar\/campaignBaseInfo) script-path=https://ws.wenn.in/main/Scripts/Luckin.js, requires-body=true, timeout=10, tag=瑞幸咖啡_净化

[MitM]
hostname = %APPEND% capi.lkcoffee.com
