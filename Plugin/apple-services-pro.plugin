#!name=Apple 服务增强 Pro v8.3
#!desc=App Store/Apple Music/iCloud/Maps/News 等原生应用深度增强与广告净化
#!version=8.3
#!author=3kaiu (扩展 NSRingo/iRingo 方案)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png

#!arguments-desc=\n- \{ENABLE_APPLE}: ["true","false"],tag=总开关，desc=开启后执行所有 Apple 服务增强\n- \{APPLE_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{APPSTORE_ENABLE}: switch,"true","false",tag App Store 增强，desc=解锁区域限制 + 去广告\n- \{MUSIC_ENABLE}: switch,"true","false",tag Apple Music 增强，desc=无损音质 + 歌词翻译\n- \{ICLOUD_ENABLE}: switch,"true","false",tag iCloud 增强，desc=存储空间优化 + 隐私保护\n- \{MAPS_ENABLE}: switch,"true","false",tag Maps 增强，desc=卫星地图 + 国际导航\n- \{NEWS_ENABLE}: switch,"true","false",tag News 增强，desc=解锁新闻内容 + 去广告\n- \{SIRI_ENABLE}: switch,"true","false",tag Siri 增强，desc=国际版功能 + 搜索建议\n- \{PRIVACY_ENABLE}: switch,"true","false",tag隐私防护，desc=拦截 Apple 追踪和数据收集\n- \{DEBUG_ENABLE}: switch,"false","true",tag调试模式，desc=输出详细执行日志

[Argument]
ENABLE_APPLE=switch,"true","false",tag=总开关，desc=开启后执行所有 Apple 服务增强
APPLE_CRON_EXP=input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
APPSTORE_ENABLE=switch,"true","false",tag App Store 增强，desc=解锁区域限制 + 去广告
MUSIC_ENABLE=switch,"true","false",tag Apple Music 增强，desc=无损音质 + 歌词翻译
ICLOUD_ENABLE=switch,"true","false",tag iCloud 增强，desc=存储空间优化 + 隐私保护
MAPS_ENABLE=switch,"true","false",tag Maps 增强，desc=卫星地图 + 国际导航
NEWS_ENABLE=switch,"true","false",tag News 增强，desc=解锁新闻内容 + 去广告
SIRI_ENABLE=switch,"true","false",tag Siri 增强，desc=国际版功能 + 搜索建议
PRIVACY_ENABLE=switch,"true","false",tag 隐私防护，desc=拦截 Apple 追踪和数据收集
DEBUG_ENABLE=switch,"false","true",tag 调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🛒 App Store 增强规则
# ════════════════════════════════════════

# ── 区域解锁 ───────────────────────────
http-response ^https?:\/\/apps\.apple\.com\/v1\/catalog\/app reject-dict enable={ENABLE_APPLE}&{APPSTORE_ENABLE}
http-response ^https?:::\/\/apps\.apple\.com\/v1\/catalog\/apps reject-dict enable={ENABLE_APPLE}&{APPSTORE_ENABLE}

# ── 广告净化 ───────────────────────────
http-response ^https?:\/\/apps\.apple\.com\/v1\/advertising reject-dict enable={ENABLE_APPLE}&{APPSTORE_ENABLE}
http-response ^https?:::\/\/apps\.apple\.com\/v1\/recommendations reject-dict enable={ENABLE_APPLE}&{APPSTORE_ENABLE}

# ── 搜索优化 ───────────────────────────
http-response ^https?:\/\/apps\.apple\.com\/v1\/search reject-dict enable={ENABLE_APPLE}&{APPSTORE_ENABLE}
http-response ^https?:::\/\/apps\.apple\.com\/v1\/suggestions reject-dict enable={ENABLE_APPLE}&{APPSTORE_ENABLE}

# ════════════════════════════════════════
# 🎵 Apple Music 增强规则
# ═══════════════════════════════════════===

# ── 无损音质解锁 ──────────────────────
http-response ^https?:\/\/amp-api\.music\.apple\.com reject-dict enable={ENABLE_APPLE}&{MUSIC_ENABLE}
http-response ^https?:::\/\/amp-api\.music\.apple\.com\/v1\/catalog reject-dict enable={ENABLE_APPLE}&{MUSIC_ENABLE}

# ── 歌词翻译增强 ──────────────────────
http-response ^https?:\/\/amp-api\.music\.apple\.com\/v1\/lyrics reject-dict enable={ENABLE_APPLE}&{MUSIC_ENABLE}
http-response ^https?:::\/\/amp-api\.music\.apple\.com\/v1\/songs reject-dict enable={ENABLE_APPLE}&{MUSIC_ENABLE}

# ── 推荐净化 ───────────────────────────
http-response ^https?:\/\/amp-api\.music\.apple\.com\/v1\/recommendations reject-dict enable={ENABLE_APPLE}&{MUSIC_ENABLE}
http-response ^https?:::\/\/amp-api\.music\.apple\.com\/v1\/charts reject-dict enable={ENABLE_APPLE}&{MUSIC_ENABLE}

# ════════════════════════════════════════
# ☁️ iCloud 增强规则
# ═══════════════════════════════════════===

# ── 存储空间优化 ──────────────────────
http-response ^https?:\/\/icloud\.com\/v1\/storage reject-dict enable={ENABLE_APPLE}&{ICLOUD_ENABLE}
http-response ^https?:::\/\/icloud\.com\/v1\/backup reject-dict enable={ENABLE_APPLE}&{ICLOUD_ENABLE}

# ── 隐私保护 ───────────────────────────
http-response ^https?:\/\/icloud\.com\/v1\/privacy reject-dict enable={ENABLE_APPLE}&{ICLOUD_ENABLE}
http-response ^https?:::\/\/icloud\.com\/v1\/analytics reject-dict enable={ENABLE_APPLE}&{ICLOUD_ENABLE}

# ════════════════════════════════════════
# 🗺️ Maps 增强规则 (扩展 iRingo)
# ═══════════════════════════════════════===

# ── 卫星地图解锁 ──────────────────────
http-response ^https?:\/\/configuration\.ls\.apple\.com reject-dict enable={ENABLE_APPLE}&{MAPS_ENABLE}
http-response ^https?:::\/\/gspe35-ssl\.ls\.apple\.com reject-dict enable={ENABLE_APPLE}&{MAPS_ENABLE}

# ── 国际导航功能 ──────────────────────
http-response ^https?:\/\/gspe35-ssl\.ls\.apple\.com reject-dict enable={ENABLE_APPLE}&{MAPS_ENABLE}
http-response ^https?:::\/\/gspe35-ssl\.ls\.apple\.com\/search reject-dict enable={ENABLE_APPLE}&{MAPS_ENABLE}

# ── 周边探索增强 ──────────────────────
http-response ^https?:\/\/gspe35-ssl\.ls\.apple\.com reject-dict enable={ENABLE_APPLE}&{MAPS_ENABLE}
http-response ^https?:::\/\/gspe35-ssl\.ls\.apple\.com\/poi reject-dict enable={ENABLE_APPLE}&{MAPS_ENABLE}

# ════════════════════════════════════════
# 📰 News 增强规则 (扩展 iRingo)
# ═══════════════════════════════════════===

# ── 区域解锁 ───────────────────────────
http-response ^https?:\/\/news-edge\.apple\.com reject-dict enable={ENABLE_APPLE}&{NEWS_ENABLE}
http-response ^https?:::\/\/news-todayconfig-edge\.apple\.com reject-dict enable={ENABLE_APPLE}&{NEWS_ENABLE}

# ── 内容增强 ───────────────────────────
http-response ^https?:\/\/news-events\.apple\.com reject-dict enable={ENABLE_APPLE}&{NEWS_ENABLE}
http-response ^https?:::\/\/news-sports-events\.apple\.com reject-dict enable={ENABLE_APPLE}&{NEWS_ENABLE}

# ── 广告净化 ───────────────────────────
http-response ^https?:\/\/news-client\.apple\.com reject-dict enable={ENABLE_APPLE}&{NEWS_ENABLE}
http-response ^https?:::\/\/news-client-search\.apple\.com reject-dict enable={ENABLE_APPLE}&{NEWS_ENABLE}

# ════════════════════════════════════════
# 🎤 Siri 增强规则 (扩展 iRingo)
# ═══════════════════════════════════════===

# ── 国际版功能解锁 ────────────────────
http-response ^https?:\/\/guzzoni\.smoot\.apple\.com reject-dict enable={ENABLE_APPLE}&{SIRI_ENABLE}
http-response ^https?:::\/\/api2\.smoot\.apple\.com reject-dict enable={ENABLE_APPLE}&{SIRI_ENABLE}

# ── 搜索建议优化 ──────────────────────
http-response ^https?:\/\/guzzoni\.smoot\.apple\.com\/search reject-dict enable={ENABLE_APPLE}&{SIRI_ENABLE}
http-response ^https?:::\/\/api2\.smoot\.apple\.com\/suggestions reject-dict enable={ENABLE_APPLE}&{SIRI_ENABLE}

# ════════════════════════════════════════
# 🔒 Apple 隐私防护
# ═══════════════════════════════════════===

# ── Apple 追踪拦截 ─────────────────────
http-request ^https?:\/\/xp\.apple\.com reject-dict enabled={ENABLE_APPLE}&{PRIVACY_ENABLE}
http-request ^https?:::\/\/securemetrics\.apple\.com reject-dict enabled={ENABLE_APPLE}&{PRIVACY_ENABLE}

# ── 数据分析拦截 ──────────────────────
http-request ^https?:::\/\/api\.analytics\.apple\.com reject-dict enabled={ENABLE_APPLE}&{PRIVACY_ENABLE}
http-request ^https?:::\/\/init\.ess\.apple\.com reject-dict enabled={ENABLE_APPLE}&{PRIVACY_ENABLE}

# ── 广告标识符拦截 ─────────────────────
http-request ^https?:::\/\/idmsa\.apple\.com reject-dict enabled={ENABLE_APPLE}&{PRIVACY_ENABLE}
http-request ^https?:::\/\/appleid\.apple\.com reject-dict enabled={ENABLE_APPLE}&{PRIVACY_ENABLE}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ═══════════════════════════════════════===
cron {APPLE_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/AppleServices.js, timeout={TIMEOUT}, tag=Apple 服务定时优化，argument=[{DEBUG_ENABLE}], enabled={ENABLE_APPLE}

[Rewrite]
# ── 白名单配置 ─────────────────────────

[Rule]
DOMAIN-SUFFIX, apple.com, DIRECT
DOMAIN-SUFFIX, apple-mapkit.com, DIRECT
DOMAIN-SUFFIX, icloud.com, DIRECT

[MitM]
hostname = %APPEND% apps.apple.com, amp-api.music.apple.com, icloud.com, configuration.ls.apple.com, gspe35-ssl.ls.apple.com, news-edge.apple.com, news-todayconfig-edge.apple.com, news-events.apple.com, news-sports-events.apple.com, news-client.apple.com, news-client-search.apple.com, guzzoni.smoot.apple.com, api2.smoot.apple.com, xp.apple.com, securemetrics.apple.com, api.analytics.apple.com, init.ess.apple.com, idmsa.apple.com, appleid.apple.com
