#!name=喜马拉雅去广告 Pro v1.0
#!desc=喜马拉雅 — 去广告/直播/红包/GIF弹窗/开屏/版本更新净化
#!version=1.0
#!author=3kaiu (基于 ddgksf2013 移植)
#!homepage=https://github.com/3kaiu/config
#!icon=https://icons.duckduckgo.com/ip3/www.ximalaya.com.ico
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

[Rewrite]
# ── 直播/红包/GIF弹窗/开屏/版本更新 ──
^https?:\/\/.*ximalaya\.com\/.*live.* reject-200
^https?:\/\/.*ximalaya\.com\/.*redpack.* reject-200
^https?:\/\/.*ximalaya\.com\/.*gif.*popup.* reject-200
^https?:\/\/.*ximalaya\.com\/.*gslb.* reject-200
^https?:\/\/.*ximalaya\.com\/.*version.* reject-200
^https?:\/\/.*ximalaya\.com\/.*splash.* reject-200
^https?:\/\/.*xmcdn\.com\/.*splash.* reject-200
^https?:\/\/.*ximalaya\.com\/.*ad.* reject-200
^https?:\/\/.*ximalaya\.com\/.*promotion.* reject-200
^https?:\/\/.*ximalaya\.com\/.*activity.* reject-200
^https?:\/\/.*ximalaya\.com\/.*banner.* reject-200
^https?:\/\/.*ximalaya\.com\/.*popup.* reject-200
^https?:\/\/.*ximalaya\.com\/.*update.* reject-200
^https?:\/\/.*xmcdn\.com\/.*ad.* reject-200

[Script]
# ── 响应体净化 ──
http-response ^https?:\/\/.*ximalaya\.com\/.*discovery-category\/customCategories.* script-path=https://ws.wenn.in/main/Scripts/Ximalaya.js, requires-body=true, timeout=10, tag=喜马拉雅_分类
http-response ^https?:\/\/.*ximalaya\.com\/.*discovery-category\/v\d\/category.* script-path=https://ws.wenn.in/main/Scripts/Ximalaya.js, requires-body=true, timeout=10, tag=喜马拉雅_分类详情
http-response ^https?:\/\/.*ximalaya\.com\/.*focus-mobile\/focusPic.* script-path=https://ws.wenn.in/main/Scripts/Ximalaya.js, requires-body=true, timeout=10, tag=喜马拉雅_焦点图
http-response ^https?:\/\/.*ximalaya\.com\/.*discovery-feed\/v\d\/mix.* script-path=https://ws.wenn.in/main/Scripts/Ximalaya.js, requires-body=true, timeout=10, tag=喜马拉雅_Feed
http-response ^https?:\/\/.*ximalaya\.com\/.*mobile-user\/v\d\/homePage.* script-path=https://ws.wenn.in/main/Scripts/Ximalaya.js, requires-body=true, timeout=10, tag=喜马拉雅_个人页

[MitM]
# 2026-09-11 深度审计 NEW-09: 原 `*.xima*.com` / `*.xima*.cn` 的通配落在二级域上
# (`xima*` 可匹配 ximaevil.com 等非预期注册域), 收敛为具体域并补裸域形态。
hostname = %APPEND% ximalaya.com, *.ximalaya.com, ximalaya.com.cn, *.ximalaya.com.cn, xmcdn.com, *.xmcdn.com, xmcdn.cn, *.xmcdn.cn
