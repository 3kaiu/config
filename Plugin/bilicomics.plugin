#!name=B站漫画去广告
#!desc=哔哩哔哩漫画 — 开屏/首页/搜索/我的页深度净化
#!version=7.8
#!author=3kaiu (规则来源: ddgksf2013)
#!fallback=备选: 无独立备选 — ddgksf2013 停更时需自行维护 Rewrite 规则
#!homepage=https://github.com/3kaiu/config
#!icon=https://icons.duckduckgo.com/ip3/manga.bilibili.com.ico
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

[Rewrite]
# 开屏 / 活动弹窗
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash reject-200
# 首页轮播 Banner
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Banner reject-200
# App 初始化 (开屏、运营位、商城入口、活动入口)
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/AppInit reject-200
# 首页推荐：去运营卡片
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Home\/HomeFeed reject-200
# 首页 Tab 精简
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetClassPageAllTabs reject-200
# 活动 Tab
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetActivityTab reject-200
# 气泡
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetBubbles reject-200
# 福利横幅
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetWelfareBanner reject-200
# 运营横幅
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetOperaterBanner reject-200
# 通用横幅/畅读卡
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetCommonBanner reject-200
# Hook Banner
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/GetHookBanner reject-200
# 我的页营销（只保留"我的已购"）
^https:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/UCenterConf reject-200
# 营销中心入口
^https:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/GetMarketingCenterInfo reject-200
# 搜索框填词
^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetSearchBoxKeyword reject-200
# 搜索页展示
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/SearchDisplay reject-200
# 搜索页 Banner
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/SearchBanner reject-200
# 搜索页猜你喜欢
^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetGuessLabel reject-200
# 热搜
^https:\/\/manga\.bilibili\.com\/twirp\/search\.v\d\.Search\/GetHotSearch reject-200
# 红点
^https:\/\/manga\.bilibili\.com\/twirp\/line\.v\d\.Line\/TabRedDot reject-200
# 推荐
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Recommend reject-200

[MitM]
hostname = %APPEND% manga.bilibili.com