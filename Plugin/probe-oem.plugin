#!name=厂商自有遥测上报拦截
#!desc=小米 mistat / vivo / OPPO / 魅族 自有统计与广告上报通道拦截。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = 隐私,探针,上报,小米,vivo,oppo,魅族,探针,隐私
#!type = normal
# 本插件**无 [Argument]**: 官方《插件》策略位仅 DIRECT/REJECT/PROXY, 插件参数只作用于
# Script(enable={}) 与 Rewrite(${}); 普通 [Rule] 行挂不了条件 ⇒ 声明即死参数。
# 启停插件即开关。

[Rule]
# ── 生效层: L2 域名 REJECT (DNS 阶段) ────────────────────────────
# 本仓 domain-reject-mode = DNS ⇒ 拒绝在 DNS 阶段回环完成, 请求到不了解密层。
# 故本插件**无 [MitM]**, 零 CA 证书成本。
#
# 处置口径: 只拦 **mistat 统计 / adxlog·adlog 广告日志 / ads-sdk·adsfs·adreq 广告请求 / umid·uxip 设备标识**; **不拦商店(ad.apk.vivo)、推送(xmpush/res)、系统设置(bss·de·dvb·jellyfish pandora)** —— 拦商店域会影响 App 分发与更新。
# 代价: 丢失厂商侧统计/广告请求, 隐私收益最大(设备标识上报是隐私监管重点)。
# 取证: DoH(Cloudflare + DNS.google **双解析器交叉**) + HTTPS 探针; 逐条核验存在性,
# 不凭印象写域名; 已剔除已死域与主配置已覆盖的域。

DOMAIN, data.mistat.xiaomi.com, REJECT
DOMAIN, storeconfig.mistat.xiaomi.com, REJECT
DOMAIN, resolver.msg.xiaomi.net, REJECT
DOMAIN, adxlog.vivo.com.cn, REJECT
DOMAIN, adlog.vivo.com.cn, REJECT
DOMAIN, stsdk.vivo.com.cn, REJECT
DOMAIN, stsdk.vivoglobal.com, REJECT
DOMAIN, adreq.vivo.com.cn, REJECT
DOMAIN, adsfs.oppomobile.com, REJECT
DOMAIN, umid.orion.meizu.com, REJECT
DOMAIN, uxip.meizu.com, REJECT
DOMAIN, aider-res.meizu.com, REJECT
