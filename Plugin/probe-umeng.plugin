#!name=友盟+ 上报拦截
#!desc=友盟+(Umeng)统计与崩溃上报通道拦截。纯遥测, 拦了不破功能。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = 隐私,探针,上报,友盟,umeng,探针,隐私
#!type = normal
# 本插件**无 [Argument]**: 官方《插件》策略位仅 DIRECT/REJECT/PROXY, 插件参数只作用于
# Script(enable={}) 与 Rewrite(${}); 普通 [Rule] 行挂不了条件 ⇒ 声明即死参数。
# 启停插件即开关。

[Rule]
# ── 生效层: L2 域名 REJECT (DNS 阶段) ────────────────────────────
# 本仓 domain-reject-mode = DNS ⇒ 拒绝在 DNS 阶段回环完成, 请求到不了解密层。
# 故本插件**无 [MitM]**, 零 CA 证书成本。
#
# 处置口径: 只拦**统计/日志/崩溃**上报域 (alog/alogs/cnlogs/errlog/errnewlog/ulogs/plbslog/sec/ucc/uop/utoken/ar/aaid); **不拦 config./user./msg. 与 jpush/getui 推送通道** —— 断推送是真功能损失(AGENTS.md 已记 '全拦 SUFFIX 会断推送')。
# 代价: 丢失友盟统计与崩溃可见性, 开发者将看不到崩溃堆栈与日活数据。
# 取证: DoH(Cloudflare + DNS.google **双解析器交叉**) + HTTPS 探针; 逐条核验存在性,
# 不凭印象写域名; 已剔除已死域与主配置已覆盖的域。

DOMAIN, alog.umeng.com, REJECT
DOMAIN, alog.umengcloud.com, REJECT
DOMAIN, alogs.umeng.com, REJECT
DOMAIN, alogs.umengcloud.com, REJECT
DOMAIN, cnlogs.umeng.com, REJECT
DOMAIN, errlog.umeng.com, REJECT
DOMAIN, errnewlog.umeng.com, REJECT
DOMAIN, plbslog.umeng.com, REJECT
DOMAIN, ulogs.umeng.com, REJECT
DOMAIN, ulogs.umengcloud.com, REJECT
DOMAIN, sec.umeng.com, REJECT
DOMAIN, ucc.umeng.com, REJECT
DOMAIN, utoken.umeng.com, REJECT
DOMAIN, aaid.umeng.com, REJECT
DOMAIN, aspect-upush.umeng.com, REJECT
