#!name=抖音去广告
#!desc=抖音 - 信息流/广告净化 + 日志请求拦截
#!version=8.0
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Douyin.png

#!arguments-desc=\n- \{DOUYIN_ENABLE}: switch,"true","false",tag=总开关，desc=开启后执行所有抖音净化功能

[Argument]
DOUYIN_ENABLE=switch,"true","false",tag=总开关，desc=开启后执行所有抖音净化功能

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 信息流净化模块 ────────────────────
http-response ^https?://(api|aweme)\.amemv\.com\/aweme\/v[12]\/ script-path=https://ws.wenn.in/main/Scripts/Douyin.js, requires-body=true, timeout=10, tag=抖音信息流净化, enable={DOUYIN_ENABLE}
http-response ^https?://api5-normal-dsa\.amemv\.com script-path=https://ws.wenn.in/main/Scripts/Douyin.js, requires-body=true, timeout=10, tag=抖音广告净化, enable={DOUYIN_ENABLE}

# ── 日志请求拦截模块 ──────────────────
http-response ^https?://log\.snssdk\.com url reject-200, enable={DOUYIN_ENABLE}

[MitM]
hostname = %APPEND% api.amemv.com, aweme.snssdk.com, api5-normal-dsa.amemv.com, log.snssdk.com
