#!name=小红书去广告 Pro v8.0
#!desc=小红书 — 开屏/信息流/搜索/水印去除全流程净化 + 功能模块控制
#!version=8.0
#!author=3kaiu (参考 ddgksf2013/XiaoHongShuAds.conf + app2smile)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/XiaoHongShu.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

#!arguments-desc=\n- \{ENABLE_XHS}: ["true","false"],tag=总开关，desc=开启后执行所有小红书功能\n- \{XHS_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{XHS_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{XHS_FEED_ENABLE}: switch,"true","false",tag=信息流净化，desc=去除首页推荐广告\n- \{XHS_SEARCH_ENABLE}: switch,"true","false",tag=搜索净化，desc=去除搜索推广词条\n- \{XHS_WATERMARK_ENABLE}: switch,"true","false",tag=去水印，desc=去除图片/视频水印\n- \{XHS_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_XHS=switch,"true","false",tag=总开关，desc=开启后执行所有小红书功能
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
XHS_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
XHS_FEED_ENABLE=switch,"true","false",tag=信息流净化，desc=去除首页推荐广告
XHS_SEARCH_ENABLE=switch,"true","false",tag=搜索净化，desc=去除搜索推广词条
XHS_WATERMARK_ENABLE=switch,"true","false",tag=去水印，desc=去除图片/视频水印
XHS_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/home-api\.xiaohongshu\.com\/splash\/config url reject-200, enable={ENABLE_XHS}&{XHS_SPLASH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config url reject-200, enable={ENABLE_XHS}&{XHS_SPLASH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/ads url reject-200, enable={ENABLE_XHS}&{XHS_SPLASH_ENABLE}

# ── 信息流净化模块 ────────────────────
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/homefeed reject-dict enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/note\/feed reject-dict enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/user\/posted reject-dict enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/discovery\/recommend reject-dict enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/page\/notes reject-dict enable={ENABLE_XHS}&{XHS_FEED_ENABLE}

# ── 搜索净化模块 ──────────────────────
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/notes reject-dict enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/recommend reject-dict enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/trending reject-dict enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/hot_list reject-dict enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}

# ── 去水印模块 ────────────────────────
http-response ^https?:\/\/sns-img-bd\.xhscdn\.com\/.*\.jpg reject-dict enable={ENABLE_XHS}&{XHS_WATERMARK_ENABLE}
http-response ^https?:\/\/sns-video-bd\.xhscdn\.com\/.*\.mp4 reject-dict enable={ENABLE_XHS}&{XHS_WATERMARK_ENABLE}
http-response ^https?:\/\/ci\.xiaohongshu\.com\/.*\.(jpg|png|mp4) reject-dict enable={ENABLE_XHS}&{XHS_WATERMARK_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/home reject-dict enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/feed reject-dict enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/note reject-dict enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/profile reject-dict enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/search reject-dict enable={ENABLE_XHS}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════

[Rewrite]
# ── 白名单配置 ────────────────────────

# ── 特殊域名重定向 ──────────────────
request if ${url} ~= /^https?:\/\/xhslink\.com\/\?(https?)?(%3A|:)?(\/\/|%2F%2F)?(.*)$/i as urlMatch && ${ENABLE_XHS} == true then redirect(302, "https://${urlMatch.4}")

[Rule]
DOMAIN-SUFFIX, xiaohongshu.com, DIRECT
DOMAIN-SUFFIX, xhscdn.com, DIRECT

[MitM]
hostname = %APPEND% api.xiaohongshu.com, home-api.xiaohongshu.com, sns-img-bd.xhscdn.com, sns-video-bd.xhscdn.com, ci.xiaohongshu.com
