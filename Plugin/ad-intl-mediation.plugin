#!name=国际广告聚合/变现平台拦截
#!desc=AppLovin·Vungle·Chartboost·Fyber·Mintegral·Tapjoy·Ogury·AdColony·AdMost·StartApp·SmartAdServer 等国际广告 SDK 与变现平台拦截。零证书成本。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = 去广告,广告平台,国际,AppLovin,Vungle,Mintegral
#!type = normal
# 本插件**无 [Argument]**: 官方《插件》策略位仅 DIRECT/REJECT/PROXY, 插件参数只作用于
# Script(enable={}) 与 Rewrite(${}); 普通 [Rule] 行挂不了条件 ⇒ 声明即死参数。启停插件即开关。

[Rule]
# ── 生效层: L2 域名 REJECT (DNS 阶段) ────────────────────────────────
# 本仓 domain-reject-mode = DNS ⇒ 拒绝在 DNS 阶段回环完成, 请求到不了解密层。
# 故本插件**无 [MitM]**, 零 CA 证书成本。
#
# 基准来源: 广告主 App 的 **AdMob appads.txt**(变现平台自报来源域) + 社区规则交叉。
# 这是比任何第三方清单更硬的证据 —— appads.txt 由变现平台自己声明。
#
# 处置口径: **只拦已取证的 SDK/上报子域, 不拦平台主域**。逐条理由:
#   ① unity3d.com  = Unity 引擎本体 → 整域拦会破 Unity 游戏运行与资源加载 ❌
#   ② mopub.com     = 已并入 AppLovin(探针 302 → applovin.com/max) ⇒ 不重复
#   ③ supersonicads.com = 实测已死域(CF 解析 0 条), 不占资源 ❌
#   ④ streamkey.tv = 直播广告主站且有正常站点内容, 非 SDK 出口 ❌
#   ⑤ applovin.com / startapp.com 含开发者后台与站点 → 只拦其 SDK 子域
# 另有 24 个子域经 DoH 实测**已死**或已被主配置覆盖, 未写入(见 tools 探针留证)。
#
# 取证: Cloudflare + DNS.google 双解析器逐条核验存在性, 不凭印象写域名。
DOMAIN, d.applovin.com, REJECT
DOMAIN, ads.applovin.com, REJECT
DOMAIN, api.applovin.com, REJECT
DOMAIN, ads.api.vungle.com, REJECT
DOMAIN, events.api.vungle.com, REJECT
DOMAIN, config.ads.vungle.com, REJECT
DOMAIN, adx-cn.ads.vungle.com, REJECT
DOMAIN, api.chartboost.com, REJECT
DOMAIN, api.fyber.com, REJECT
DOMAIN, api.mintegral.com, REJECT
DOMAIN, api.tapjoy.com, REJECT
DOMAIN, api.ogury.com, REJECT
DOMAIN, ads.adcolony.com, REJECT
DOMAIN, api.admost.com, REJECT
DOMAIN, init.startappservice.com, REJECT
DOMAIN, req.startappservice.com, REJECT
DOMAIN, images.startappservice.com, REJECT
DOMAIN, init.startappexchange.com, REJECT
DOMAIN, cdn1.smartadserver.com, REJECT
DOMAIN, ww251.smartadserver.com, REJECT
DOMAIN, www6.smartadserver.com, REJECT
