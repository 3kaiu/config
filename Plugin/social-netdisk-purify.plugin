^https:\/\/appwk\.baidu\.com\/naapi\/recommend\/vipdoccard\? reject-dict enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{BAIDUWENKU_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch reject-dict enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/feed\/detail\? response-body-json-jq '.data.hotReplyRows |= if . then map(select(.id?)) else . end | .data.topReplyRows |= if . then map(select(.id?)) else . end | reduce ("detailSponsorCard", "include_goods", "include_goods_ids") as $key (.; .data[$key]=[])' enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/feed\/replyList response-body-json-jq 'if .data? and ((.data | type) == "array") and (.data | length > 0) then .data |= map(select(.id?)) else . end' enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/main\/dataList response-body-json-jq '.data |= (if (type=="array" and length>0) then map(select((.entityTemplate!="sponsorCard") and (.title!="精选配件"))) else . end)' enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/page\/dataList response-body-json-jq 'if (.data | length > 0) then .data |= map(select((.title? != "酷安热搜") and (.entityTemplate? != "imageScaleCard") and (.entityTemplate? != "sponsorCard"))) else . end' enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/main\/indexV8 response-body-json-jq '.data |= (if length > 0 then map(select((.entityTemplate != "sponsorCard") and ([8639,29349,33006,32557] | index(.entityId) | not) and ((.title // "" | test("值得买|红包")) | not))) else . end)' enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/api\.coolapk\.com\/v6\/main\/init response-body-json-jq '.data |= map(select(.entityId? | [944,945,6390] | index(.) | not) | if .entityId == 20131 then .entities |= map(select(.title != "酷品")) else . end)' enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{COOLAPK_ENABLE}
^https:\/\/games\.mobileapi\.hupu\.com\/\d\/\d\.\d\.\d+\/bplapi\/reddot\/v1\/app\/getReddot reject-dict enable={SOCIAL_NETDISK_PURIFY_ENABLE}&{HUPU_ENABLE}
