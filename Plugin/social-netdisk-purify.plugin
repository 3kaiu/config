[Argument]
SOCIAL_NETDISK_PURIFY_ENABLE=switch,"true","false",tag=总开关,desc=关闭后整组净化全部停用
ALIYUNDRIVE_ENABLE=switch,"true","false",tag=是否开启阿里云盘净化,desc=阿里云盘去广告
BAIDUPHOTO_ENABLE=switch,"true","false",tag=是否开启一刻相册净化,desc=一刻相册去广告
BAIDUTRANSLATE_ENABLE=switch,"true","false",tag=是否开启百度翻译净化,desc=百度翻译去广告
BAIDUWENKU_ENABLE=switch,"true","false",tag=是否开启百度文库净化,desc=百度文库去广告
COOLAPK_ENABLE=switch,"true","false",tag=是否开启酷安净化,desc=酷安去广告
HUPU_ENABLE=switch,"true","false",tag=是否开启虎扑净化,desc=虎扑去广告
JUMP_ENABLE=switch,"true","false",tag=是否开启Jump净化,desc=Jump去广告
LOL_BIBLE_ENABLE=switch,"true","false",tag=是否开启掌上英雄联盟净化,desc=掌上英雄联盟去广告
MAIMAI_ENABLE=switch,"true","false",tag=是否开启脉脉净化,desc=脉脉去广告
MAILMASTER_ENABLE=switch,"true","false",tag=是否开启网易邮箱大师净化,desc=网易邮箱大师去广告
NETEASEGODLIKE_ENABLE=switch,"true","false",tag=是否开启网易大神净化,desc=网易大神去广告
PICC_INSURANCE_ENABLE=switch,"true","false",tag=是否开启中国人保净化,desc=中国人保去广告
QUARKBROWSER_ENABLE=switch,"true","false",tag=是否开启夸克净化,desc=夸克去广告
QUARKSCANKING_ENABLE=switch,"true","false",tag=是否开启夸克扫描王净化,desc=夸克扫描王去广告
TXDOCS_ENABLE=switch,"true","false",tag=是否开启腾讯文档净化,desc=腾讯文档去广告
VALORANTBIBLE_ENABLE=switch,"true","false",tag=是否开启掌上无畏契约净化,desc=掌上无畏契约去广告
WPFORUM_ENABLE=switch,"true","false",tag=是否开启威锋净化,desc=威锋去广告
WPS_DOCUMENTS_ENABLE=switch,"true","false",tag=是否开启金山文档净化,desc=金山文档去广告
WEIBO_INTL_ENABLE=switch,"true","false",tag=是否开启微博轻享版净化,desc=微博轻享版去广告
XIAOHEIHE_ENABLE=switch,"true","false",tag=是否开启小黑盒净化,desc=小黑盒去广告
XIAOMISPEAKER_ENABLE=switch,"true","false",tag=是否开启小米音箱净化,desc=小米音箱去广告
YOUDAODICT_ENABLE=switch,"true","false",tag=是否开启网易有道词典净化,desc=网易有道词典去广告
YOUDAONOTE_ENABLE=switch,"true","false",tag=是否开启有道云笔记净化,desc=有道云笔记去广告
YOUDAOTRANS_ENABLE=switch,"true","false",tag=是否开启有道翻译官净化,desc=有道翻译官去广告
WEXINMINIPROGRAMS_REMOVE_ENABLE=switch,"true","false",tag=是否开启微信小程序净化,desc=微信小程序去广告

