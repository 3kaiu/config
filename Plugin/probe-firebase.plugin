#!name=Firebase/Segment 统计拦截
#!desc=Firebase Crashlytics 配置域与 Segment CDN 设置域拦截(主配置 google-analytics/crashlytics 之外的增量)。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = 隐私,探针,上报,firebase,crashlytics,segment
#!type = normal
# 本插件**无 [Argument]**: 官方《插件》策略位仅 DIRECT/REJECT/PROXY, 插件参数只作用于
# Script(enable={}) 与 Rewrite(${}); 普通 [Rule] 行挂不了条件 ⇒ 声明即死参数。
# 启停插件即开关。

[Rule]
# ── 生效层: L2 域名 REJECT (DNS 阶段) ────────────────────────────
# 本仓 domain-reject-mode = DNS ⇒ 拒绝在 DNS 阶段回环完成, 请求到不了解密层。
# 故本插件**无 [MitM]**, 零 CA 证书成本。
#
# 处置口径: crashlytics.googleapis.com 等主配置已覆盖, 这里只补 e./setting(s).crashlytics.com 与 segment 设置域。
# 代价: 丢失崩溃报告与埋点下发配置。
# 取证: DoH(Cloudflare + DNS.google **双解析器交叉**) + HTTPS 探针; 逐条核验存在性,
# 不凭印象写域名; 已剔除已死域与主配置已覆盖的域。

DOMAIN, cdn-settings.segment.com, REJECT
