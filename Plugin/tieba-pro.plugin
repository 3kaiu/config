#!name=贴吧去广告 Pro v7.8
#!desc=百度贴吧 — 首页/帖子列表/广告全流程净化 + 功能模块控制
#!version=7.8
#!author=3kaiu (基于通用插件增强框架)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Tieba.png

#!arguments-desc=\n- \{ENABLE_TIEBA}: ["true","false"],tag=总开关，desc=开启后执行所有贴吧功能\n- \{TIEBA_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,60,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{TIEBA_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页推荐/广告\n- \{TIEBA_POST_ENABLE}: switch,"true","false",tag=帖子净化，desc=去除帖子内广告/推广\n- \{TIEBA_SEARCH_ENABLE}: switch,"true","false",tag=搜索净化，desc=去除搜索结果推广\n- \{TIEBA_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_TIEBA=switch,"true","false",tag=总开关，desc=开启后执行所有贴吧功能
TIMEOUT=input,60,tag=超时时间 (秒), desc=脚本最大执行时长
TIEBA_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页推荐/广告
TIEBA_POST_ENABLE=switch,"true","false",tag=帖子净化，desc=去除帖子内广告/推广
TIEBA_SEARCH_ENABLE=switch,"true","false",tag=搜索净化，desc=去除搜索结果推广
TIEBA_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Rule]
# ── 广告 IP 拦截 ─────────────────────
IP-CIDR,180.76.76.200/32,REJECT,no-resolve,enable={ENABLE_TIEBA}

[Script]
# ═══════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ═══════════════════════════════════════════

# JSON 处理（首页/帖子列表/搜索）
http-response ^https?:\/\/(tiebac|tieba|tiebaapi)\.baidu\.com script-path=https://ws.wenn.in/main/Scripts/Tieba.js, requires-body=true, timeout=10, tag=贴吧_JSON 净化，enable={ENABLE_TIEBA}

# Proto 处理（二进制协议）
http-response ^https?:\/\/(tiebac|tieba|tiebaapi)\.baidu\.com.*\?cmd script-path=https://ws.wenn.in/main/Scripts/Tieba.js, binary-body-mode=true, requires-body=true, timeout=10, tag=贴吧_Proto 净化，enable={ENABLE_TIEBA}

# ═══════════════════════════════════════════
# ⏰ Cron 定时任务（签到 + 清理）
# ═══════════════════════════════════════════
cron {TIEBA_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/Tieba.js, timeout={TIMEOUT}, tag=贴吧定时任务，argument=[{TIEBA_DEBUG_ENABLE}], enable={ENABLE_TIEBA}

[MitM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com, tiebaapi.baidu.com
