#!name=贴吧去广告 Pro v7.9
#!desc=百度贴吧 — 首页/帖子列表/广告全流程净化（JSON + Proto 双模式）
#!version=7.9
#!author=3kaiu (基于通用插件增强框架)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Tieba.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_TIEBA}: ["true","false"],tag=总开关, desc=开启后执行所有贴吧功能

[Argument]
ENABLE_TIEBA=switch,"true","false",tag=总开关，desc=开启后执行所有贴吧功能

[Rule]
# ── 广告 IP 拦截 ─────────────────────
IP-CIDR,180.76.76.200/32,REJECT,no-resolve,enable={ENABLE_TIEBA}

[Script]
# ═══════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# v7.9 (2026-08 审计): 移除虚设 cron (脚本无签到逻辑) 与 3 个虚设开关
# (TIEBA_HOME/POST/SEARCH_ENABLE 未被任何规则引用, 开关无实际效果)
# ═══════════════════════════════════════════

# JSON 处理（首页/帖子列表/搜索）
http-response ^https?:\/\/(tiebac|tieba|tiebaapi)\.baidu\.com script-path=https://ws.wenn.in/main/Scripts/Tieba.js, requires-body=true, timeout=10, tag=贴吧_JSON 净化，enable={ENABLE_TIEBA}

# Proto 处理（二进制协议）
http-response ^https?:\/\/(tiebac|tieba|tiebaapi)\.baidu\.com.*\?cmd script-path=https://ws.wenn.in/main/Scripts/Tieba.js, binary-body-mode=true, requires-body=true, timeout=10, tag=贴吧_Proto 净化，enable={ENABLE_TIEBA}

[MitM]
hostname = %APPEND% tiebac.baidu.com, tieba.baidu.com, tiebaapi.baidu.com
