#!name=穿山甲去广告
#!desc=穿山甲(Pangolin)广告上报与素材域拦截。DNS 阶段生效, 不解密不抓包, 零证书成本。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = 去广告,广告平台,穿山甲,字节,pangolin
#!type = normal
# 本插件**无 [Argument]**: 官方《插件》仅支持策略位 DIRECT/REJECT/PROXY,
# 插件参数只作用于 Script(enable={}) 与 Rewrite(${}); 普通 [Rule] 行无法挂条件
# ⇒ 死参数会误导用户以为能开关。按平台拆成独立插件, 启停插件即按平台开关。

[Rule]
# ── 生效层: L2 域名 REJECT ──────────────────────────────────────
# 本仓 domain-reject-mode = DNS + dns-reject-mode = LOOPBACKIP ⇒ 拒绝在
# **DNS 阶段**用回环地址完成, 请求到不了 HTTP 响应层。故本插件**无 [MitM]**,
# 拦广告零 CA 证书成本 (不进解密面 = 不多背一份证书信任)。
# 官方《策略》: REJECT-DICT/IMG/ARRAY 等变体描述的都是 HTTP 响应内容,
# 在 DNS 阶段拒绝的场景下**不适用** (见 AGENTS.md 策略层 REJECT 变体定论)。
#
# snssdk 系只取**埋点/日志**域; 已排除 aweme 内容流 / video-cn 视频CDN / temai 电商 / tnc3 内容 / bytescm 通用CDN / gecko-pangle 落地页 —— 拦这些会破抖音内容与功能。
# 取证: DoH(Cloudflare + DNS.google 双解析器) + HTTPS 探针; 已剔除已死域、
# 平台主域、以及主配置已覆盖的域(避免跨层重复)。

DOMAIN, i.snssdk.com, REJECT
DOMAIN, is.snssdk.com, REJECT
DOMAIN, i-lq.snssdk.com, REJECT
DOMAIN, is-lq.snssdk.com, REJECT
DOMAIN, security-lq.snssdk.com, REJECT
DOMAIN, pangolin.snssdk.com, REJECT
DOMAIN, mercury-sdk.snssdk.com, REJECT
DOMAIN, log.snssdk.com, REJECT
DOMAIN, xlog.snssdk.com, REJECT
DOMAIN, mcs.snssdk.com, REJECT
DOMAIN, extlog.snssdk.com, REJECT
DOMAIN, sdfp.snssdk.com, REJECT
DOMAIN, gurd.snssdk.com, REJECT
DOMAIN, bds.snssdk.com, REJECT
# [已由主配置覆盖而移除] ether-pack.pangolin-sdk-toutiao.com ⊂ pangolin-sdk-toutiao.com
DOMAIN, api-access.pangolin-sdk-toutiao-b.com, REJECT
DOMAIN, log-api.pangolin-sdk-toutiao-b.com, REJECT
DOMAIN, sf3-be-pack.pglstatp-toutiao.com, REJECT
