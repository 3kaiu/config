#!name=酷狗音乐去广告
#!desc=酷狗音乐 - 开屏/移动广告/信息流推广净化 (ads/mobilead/gateway 三端点 JSON 级过滤)
#!version=7.8
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Kugou_Music.png

[Argument]
KUGOU_ENABLE=switch,"true","false",tag=是否开启酷狗音乐去广告,desc=开启后净化开屏/移动/信息流 Banner 广告

[Script]
# 广告投放 (ads.kugou.com) - 清空广告数组
http-response ^https?:\/\/ads\.kugou\.com script-path=https://ws.wenn.in/main/Scripts/Kugou.js, requires-body=true, timeout=10, tag=酷狗_广告投放, enable={KUGOU_ENABLE}
# 移动广告 (mobilead.kugou.com) - 清空广告数组
http-response ^https?:\/\/mobilead\.kugou\.com script-path=https://ws.wenn.in/main/Scripts/Kugou.js, requires-body=true, timeout=10, tag=酷狗_移动广告, enable={KUGOU_ENABLE}
# 信息流广告 (gateway.kugou.com) - 移除 banner/promo 字段
http-response ^https?:\/\/gateway\.kugou\.com script-path=https://ws.wenn.in/main/Scripts/Kugou.js, requires-body=true, timeout=10, tag=酷狗_信息流, enable={KUGOU_ENABLE}

[MitM]
hostname = %APPEND% ads.kugou.com, mobilead.kugou.com, gateway.kugou.com
