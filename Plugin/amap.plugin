#!name=高德地图去广告
#!desc=高德地图 — 导航/首页/我的/附近/打车/开屏 深度净化
#!version=7.9
#!author=3kaiu (规则来源: RuCu6/kokoryh)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Amap.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

[Argument]
AMAP_ENABLE=switch,"true","false",tag=是否开启高德地图去广告,desc=开启后深度净化高德地图导航/首页/打车等广告

[Rule]
DOMAIN,amap-aos-info-nogw.amap.com,REJECT,enable={AMAP_ENABLE}
DOMAIN,awaken.amap.com,REJECT,enable={AMAP_ENABLE}
DOMAIN,free-aos-cdn-image.amap.com,REJECT,enable={AMAP_ENABLE}

[Rewrite]
# ── 导航详情页 ──
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/dsp\/card-service-(car-end|route-plan)/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/dsp\/new_hotword/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/dsp\/tips_adv/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/dsp\/banner\/lists/i && ${AMAP_ENABLE} == true then reject_dict(200)

# ── 首页 ──
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/main-page-(assets|location)/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/hint_text/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/message\/notice\/list/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/scene\/recommend/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/weather\/v2/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/msgbox\/pull_mp/i && ${AMAP_ENABLE} == true then reject_dict(200)

# ── 打车页 ──
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/king_toolbox_car_bubble/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/onscene_visual_optimization/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/content_info/i && ${AMAP_ENABLE} == true then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/friendly_information/i && ${AMAP_ENABLE} == true then reject_dict(200)

# ── AMDC 通用 ──
request if ${url} ~= /^https:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch/i && ${AMAP_ENABLE} == true then reject_dict(200)

# ── Response 兜底层 (v7.9): 替代 13 条 http-response 脚本，行为与 Amap.js 等价 (data={})
# 设计: request reject_dict 优先生效；此处 response.json.jq 在 reject 未生效时兜底，双保险
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/dsp\/(card-service-(car-end|route-plan)|new_hotword|tips_adv|banner\/lists)/i && ${AMAP_ENABLE} == true then response.json.jq(".data = {}")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/(main-page-(assets|location)|hint_text|message\/notice\/list|scene\/recommend)/i && ${AMAP_ENABLE} == true then response.json.jq(".data = {}")
response if ${url} ~= /^https:\/\/m5\.amap\.com\/dsp\/(weather\/v2|king_toolbox_car_bubble|onscene_visual_optimization|content_info)/i && ${AMAP_ENABLE} == true then response.json.jq(".data = {}")

[MitM]
# ⚠️ 修复(v7.3): 移除 oss.amap.com 和 sns.amap.com (无对应Rule/Script, 冗余 MitM 解密开销)
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, amdc.m.taobao.com