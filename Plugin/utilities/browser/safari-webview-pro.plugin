#!name=Safari/WebView 净化工具箱 Pro v8.2
#!desc=Safari 浏览器 + WebView 应用 - 全方位广告拦截与隐私保护
#!version=8.2
#!author=3kaiu (参考 Adblock4limbo + limbopro/Adblock4limbo)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Safari.png

#!arguments-desc=\n- \{ENABLE_BROWSE}: ["true","false"],tag=总开关，desc=开启后执行所有浏览器净化功能\n- \{BROWSE_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{WEBVIEW_ENABLE}: switch,"true","false",tag=WebView 净化，desc=清除 WebView 内嵌网页广告\n- \{SAFARI_ENABLE}: switch,"true","false",tag=Safari 净化，desc=清除 Safari 浏览器广告\n- \{TRACKER_ENABLE}: switch,"true","false",tag=追踪防护，desc=拦截第三方追踪器\n- \{PRIVACY_ENABLE}: switch,"true","false",tag=隐私增强，desc=指纹识别防护\n- \{COOKIES_ENABLE}: switch,"true","false",tag=Cookies 管理，desc=智能 Cookie 清理\n- \{DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_BROWSE=switch,"true","false",tag=总开关，desc=开启后执行所有浏览器净化功能
BROWSE_CRON_EXP=input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
WEBVIEW_ENABLE=switch,"true","false",tag=WebView 净化，desc=清除 WebView 内嵌网页广告
SAFARI_ENABLE=switch,"true","false",tag=Safari 净化，desc=清除 Safari 浏览器广告
TRACKER_ENABLE=switch,"true","false",tag=追踪防护，desc=拦截第三方追踪器
PRIVACY_ENABLE=switch,"true","false",tag=隐私增强，desc=指纹识别防护
COOKIES_ENABLE=switch,"true","false",tag=Cookies 管理，desc=智能 Cookie 清理
DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 WebView 应用内网页净化规则
# ════════════════════════════════════════

# ── 通用 WebView 净化 ───────────────────
http-response ^https?:\/\/.*\.inapps\.com\/ads ad-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?:\/\/sdkopen\.vip\.alipay\.com\/popup popup-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?::\/\/mbs\.didiglobal\.com\/banner banner-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ── 支付宝 WebView ─────────────────────
http-response ^https?::\/\/render\.alipay.com\/portal portal-ad-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?::\/\/h5api\.alipay\.com\/gateway gateway-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ── 微信 WebView ───────────────────────
http-response ^https?:::\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad wechat-article-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?:::\/\/app\.weixin\.qq\.com\/cgi-bin app-wechat-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ── 微博 WebView ───────────────────────
http-response ^https?::\/\/api\.weibo\.cn\/2\/WBFrameFrame wb-frame-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?::\/\/h5\.weibo\.com\/wbframe wb-h5-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ── 淘宝 WebView ───────────────────────
http-response ^https?::\/\/g\.huxiu\.com\/feed feed-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?::\/\/mobileserving\.gt\.algocdn\.cn\/splash open-splash-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ── 抖音/快手 WebView ──────────────────
http-response ^https?::\/\/aweme\.snssdk\.com\/feed video-feed-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?::\/\/open\.api\.kuaishou\.com\/v1 kuaishou-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ── 小红书 WebView ─────────────────────
http-response ^https?::\/\/app\.xiaohongshu\.com\/feed xhs-feed-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}
http-response ^https?::\/\/home-api\.xiaohongshu\.com splash-filter, enable={ENABLE_BROWSE}&{WEBVIEW_ENABLE}

# ════════════════════════════════════════
# 🌐 Safari 浏览器净化规则
# ════════════════════════════════════════

# ── 网站广告拦截 ───────────────────────
http-response ^https?:\/\/page\.ad\.qq\.com ad-block-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}
http-response ^https?:\/\/count\.appannie\.com analytics-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}
http-response ^https?:\/\/stats\.expand\.microad\.jp tracking-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}

# ── 新闻站净化 ──────────────────────────
http-response ^https?:\/\/news\.so\.com\/search search-ad-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}
http-response ^https?:\/\/view\.inewsweek\.cn news-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}
http-response ^https?:\/\/roll\.news\.163\.com news-roll-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}

# ── 电商站净化 ─────────────────────────
http-response ^https?:\/\/item\.taobao\.com\/detail product-recommend-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}
http-response ^https?:\/\/pinnable\.pinterest\.com pin-ad-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}

# ── 视频站净化 ─────────────────────────
http-response ^https?:\/\/www\.youku\.com\/v-play pre-roll-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}
http-response ^https?:\/\/live\.bilibili\.com\/blank live-ad-filter, enable={ENABLE_BROWSE}&{SAFARI_ENABLE}

# ════════════════════════════════════════
# 🔒 隐私与追踪防护
# ════════════════════════════════════════

# ── 第三方追踪器 ───────────────────────
http-request ^https?:\/\/api\.loglyco\.com track-blocker, enable={ENABLE_BROWSE}&{TRACKER_ENABLE}
http-request ^https?:\/\/beacon\.telerik\.com analytics-blocker, enable={ENABLE_BROWSE}&{TRACKER_ENABLE}
http-request ^https?:\/\/collector\.gitlab\.com event-blocker, enable={ENABLE_BROWSE}&{TRACKER_ENABLE}

# ── 指纹识别防护 ───────────────────────
# 伪造浏览器指纹
http-response ^https?:\/\/who\.ami\.anti-fingerprint\.com fingerprint-mask, enable={ENABLE_BROWSE}&{PRIVACY_ENABLE}
http-response ^https?:\/\/browserleaks\.com canvas-leak, enable={ENABLE_BROWSE}&{PRIVACY_ENABLE}

# ── Cookies 智能管理 ───────────────────
# 自动清理第三方 Cookies
http-response ^https?:\/\/cookieconsent\.disqus\.com consent-clean, enable={ENABLE_BROWSE}&{COOKIES_ENABLE}
http-response ^https?:\/\/gdpr\.eu\/cookie cookie-consent-filter, enable={ENABLE_BROWSE}&{COOKIES_ENABLE}

# ── 其他防护 ───────────────────────────
# DNS 欺骗防护
http-request ^https?:\/\/dns\.leak\.test dns-test-blocker, enable={ENABLE_BROWSE}
http-request ^https?:\/\/ipinfo\.io ip-expose-blocker, enable={ENABLE_BROWSE}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════
cron {BROWSE_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/BrowserClean.js, timeout={TIMEOUT}, tag=Safari/WebView 定时清理，argument=[{DEBUG_ENABLE}], enable={ENABLE_BROWSE}

[Rewrite]
# ── 白名单配置 ────────────────────────
DOMAIN-SUFFIX, apple.com, DIRECT
DOMAIN-SUFFIX, apple-mapkit.com, DIRECT

[MitM]
hostname = %APPEND% inapps.com, sdkopen.vip.alipay.com, mbs.didiglobal.com, render.alipay.com, h5api.alipay.com, mp.weixin.qq.com, app.weixin.qq.com, api.weibo.cn, h5.weibo.com, g.huxiu.com, mobile.serving.gt.algocdn.cn, aweme.snssdk.com, open.api.kuaishou.com, app.xiaohongshu.com, home-api.xiaohongshu.com, page.ad.qq.com, count.appannie.com, stats.expand.microad.jp, news.so.com, view.inewsweek.cn, roll.news.163.com, item.taobao.com, pinnable.pinterest.com, www.youku.com, live.bilibili.com, api.loglyco.com, beacon.telerik.com, collector.gitlab.com, who.ami.anti-fingerprint.com, browserleaks.com, cookieconsent.disqus.com, gdpr.eu/, dns.leak.test, ipinfo.io
