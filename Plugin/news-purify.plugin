#!name=资讯阅读净化
#!desc=聚合: 36氪/财新/彩云/豆瓣/豆瓣阅读/虎嗅/IT之家/墨迹/网易新闻/雪球/值得买/什么值得买 — 单插件统一总开关, 各 App 独立子开关
#!version=1.0
#!author=3kaiu (聚合器生成)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/News.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag=📰 资讯阅读净化

[Argument]
NEWS_PURIFY_ENABLE=switch,"true","false",tag=总开关,desc=关闭后整组净化全部停用
36KR_ENABLE=switch,"true","false",tag=是否开启36氪净化,desc=36氪去广告
CAIXINMEDIA_ENABLE=switch,"true","false",tag=是否开启财新净化,desc=财新去广告
COLORFULCLOUDS_ENABLE=switch,"true","false",tag=是否开启彩云天气净化,desc=彩云天气去广告
DOUBAN_ENABLE=switch,"true","false",tag=是否开启豆瓣净化,desc=豆瓣去广告
DOUBANREAD_ENABLE=switch,"true","false",tag=是否开启豆瓣阅读净化,desc=豆瓣阅读去广告
HUXIU_ENABLE=switch,"true","false",tag=是否开启虎嗅净化,desc=虎嗅去广告
ITHOME_ENABLE=switch,"true","false",tag=是否开启IT之家净化,desc=IT之家去广告
MOJIWEATHER_ENABLE=switch,"true","false",tag=是否开启墨迹天气净化,desc=墨迹天气去广告
NETEASENEWS_ENABLE=switch,"true","false",tag=是否开启网易新闻净化,desc=网易新闻去广告
SNOWBALL_ENABLE=switch,"true","false",tag=是否开启雪球净化,desc=雪球去广告

[Rewrite]
^https:\/\/gateway\.36kr\.com\/api\/mis\/sys\/config\? response-body-json-del data.contentConfig data.positionConfigList data.switchConfig.ios.sunrise_sign data.switchConfig.ios.sunrise_sunit_task data.switchConfig.ios.sunrise_sunit_mall data.switchConfig.ios.sunrise_distribution_icon data.secondFloorConfig enable={NEWS_PURIFY_ENABLE&{36KR_ENABLE}}
