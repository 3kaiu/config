#!name=视频社区净化
#!desc=聚合: 抖音/快手/Reddit/飞书/智慧房东(通用开屏广告) — 单插件统一总开关, 各 App 独立子开关
#!version=1.0
#!author=3kaiu (聚合器生成)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Community.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag=🎬 视频社区净化

[Argument]
VIDEO_ENABLE=switch,"true","false",tag=总开关,desc=关闭后整组净化全部停用
DOUYIN_ENABLE=switch,"true","false",tag=总开关，desc=开启后执行所有抖音净化功能
KUAISHOU_ENABLE=switch,"true","false",tag=是否开启快手去广告,desc=开启后净化快手信息流及广告
REDDIT_ENABLE=switch,"true","false",tag=是否开启Reddit去广告,desc=开启后净化Reddit信息流中的推广帖子
FEISHU_ENABLE=switch,"true","false",tag=飞书去广告总开关,desc=开启后净化信息流推广与推荐位广告
appOpenAdsSwitch=switch,"true","false",tag=开屏广告屏蔽,desc=开启后将屏蔽App启动时的开屏广告
bannerAdsSwitch=switch,"true","false",tag=Banner广告屏蔽,desc=开启后将屏蔽App内的Banner横幅广告
adWhitelistSwitch=switch,"true","false",tag=广告白名单屏蔽,desc=开启后将屏蔽App的广告白名单接口 (adWhitelist/showAds)
activityAdsSwitch=switch,"true","false",tag=活动广告位屏蔽,desc=开启后将屏蔽活动广告位与点击上报 (clickPic/clickPicMore/platformPic)

[Script]
http-response ^https?://(api|aweme)\.amemv\.com\/aweme\/v[12]\/ script-path=https://ws.wenn.in/main/Scripts/Douyin.js, requires-body=true, timeout=10, tag=抖音信息流净化, enable={VIDEO_ENABLE}&{DOUYIN_ENABLE}
http-response ^https?://api5-normal-dsa\.amemv\.com script-path=https://ws.wenn.in/main/Scripts/Douyin.js, requires-body=true, timeout=10, tag=抖音广告净化, enable={VIDEO_ENABLE}&{DOUYIN_ENABLE}
http-response ^https?://log\.snssdk\.com url reject-200, enable={VIDEO_ENABLE}&{DOUYIN_ENABLE}
http-response ^https?:\/\/graphql\.kuaishou\.com script-path=https://ws.wenn.in/main/Scripts/Kuaishou.js, requires-body=true, timeout=10, tag=快手信息流净化, enable={VIDEO_ENABLE}&{KUAISHOU_ENABLE}
http-response ^https?:\/\/api2\.kuaishou\.com script-path=https://ws.wenn.in/main/Scripts/Kuaishou.js, requires-body=true, timeout=10, tag=快手广告净化, enable={VIDEO_ENABLE}&{KUAISHOU_ENABLE}
http-response ^https?:\/\/gql(-fed)?\.reddit\.com script-path=https://ws.wenn.in/main/Scripts/Reddit.js, requires-body=true, timeout=10, tag=Reddit_推广净化, enable={VIDEO_ENABLE}&{REDDIT_ENABLE}
http-response ^https?:\/\/internal-api\.feishu\.cn\/.*\/feed script-path=https://ws.wenn.in/main/Scripts/Feishu.js, requires-body=true, timeout=60, tag=信息流净化, enable={VIDEO_ENABLE}&{FEISHU_ENABLE}
http-response ^https?:\/\/open\.feishu\.cn\/.*\/recommend script-path=https://ws.wenn.in/main/Scripts/Feishu.js, requires-body=true, timeout=60, tag=推荐位净化, enable={VIDEO_ENABLE}&{FEISHU_ENABLE}
http-response ^https?:\/\/api\.zhihuifangdong\.net\/core\/app\/activity\/appOpenAds script-path=https://ws.wenn.in/main/Scripts/Zhihuifangdong.js, requires-body=true, timeout=10, tag=开屏广告屏蔽, argument=appOpenAds, enable={VIDEO_ENABLE}&{appOpenAdsSwitch}
http-response ^https?:\/\/api\.zhihuifangdong\.net\/core\/app\/activity\/bannerPicMore script-path=https://ws.wenn.in/main/Scripts/Zhihuifangdong.js, requires-body=true, timeout=10, tag=Banner广告屏蔽, argument=bannerPicMore, enable={VIDEO_ENABLE}&{bannerAdsSwitch}
http-response ^https?:\/\/api\.zhihuifangdong\.net\/core\/adWhitelist\/showAds script-path=https://ws.wenn.in/main/Scripts/Zhihuifangdong.js, requires-body=true, timeout=10, tag=广告白名单屏蔽, argument=showAds, enable={VIDEO_ENABLE}&{adWhitelistSwitch}
http-response ^https?:\/\/api\.zhihuifangdong\.net\/core\/app\/activity\/(clickPicMore|platformPic|clickPic) script-path=https://ws.wenn.in/main/Scripts/Zhihuifangdong.js, requires-body=true, timeout=10, tag=活动广告位屏蔽, argument=activityAds, enable={VIDEO_ENABLE}&{activityAdsSwitch}

[MitM]
hostname = %APPEND% api.amemv.com, api.zhihuifangdong.net, api2.kuaishou.com, api5-normal-dsa.amemv.com, aweme.snssdk.com, gql-fed.reddit.com, gql.reddit.com, graphql.kuaishou.com, internal-api.feishu.cn, log.snssdk.com, open.feishu.cn
