#!name=网易云音乐 Pro
#!desc=网易云 — 首页/搜索/播客/广告位净化 (纯本地 Rewrite, 无第三方脚本)
#!version=9.0
#!author=3kaiu (基于通用插件增强框架)
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_NEMUSIC}: switch,"true","false",tag=总开关，desc=开启后执行所有网易云功能\n- \{NEMUSIC_ADBLOCK_ENABLE}: switch,"true","false",tag=广告净化，desc=去除弹窗/推荐/搜索广告\n- \{NEMUSIC_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_NEMUSIC=switch,"true","false",tag=总开关，desc=开启后执行所有网易云功能
NEMUSIC_ADBLOCK_ENABLE=switch,"true","false",tag=广告净化，desc=去除弹窗/推荐/搜索广告

#==================================================================
# [Script] 段已移除 (2026-09-29): 原 16 条全部直连第三方上游 netease.adblock.js
#   按决定「移除所有依赖上游的东西」整体移除 —— 故本插件的签到/打卡/框架净化能力
#   (原由该上游 cron 脚本提供) **永久失去**, 不是待补回的缺口而是本次决定的代价。
#   保留的是 7 条 [Rewrite] 本地广告净化规则。相应死开关 (SIGNIN/CHECKIN/FRAMEWORK/
#   DEBUG/CRON_EXP/TIMEOUT) 已一并删除, 不留"拨了没反应"的假参数。
#   若日后自研脚本补回签到能力, 需同时恢复 Argument 声明与 [Script] 段。
###################################################################
[Rule]
DOMAIN-SUFFIX,music.163.com, DIRECT
DOMAIN, iadmat.nosdn.127.net, REJECT,enable={ENABLE_NEMUSIC}
DOMAIN, iadmatapk.nosdn.127.net, REJECT,enable={ENABLE_NEMUSIC}
DOMAIN, iadmusicmat.music.126.net, REJECT,enable={ENABLE_NEMUSIC}
DOMAIN, iadmusicmatvideo.music.126.net, REJECT,enable={ENABLE_NEMUSIC}
DOMAIN, ipv4.music.163.com, REJECT,enable={ENABLE_NEMUSIC}
DOMAIN, ipv6.music.163.com, REJECT,enable={ENABLE_NEMUSIC}

DOMAIN-SUFFIX,music.163.com.cn, DIRECT

[Rewrite]
^https?:\/\/interface\d?\.music\.163\.com\/e?api\/(ocpc\/)?ad\/ mock-response-body data-type=text enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}
^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:delivery\/(batch-)?deliver|moment\/tab\/info\/|side-bar\/mini-program\/music-service\/account|yunbei\/account\/entrance\/) reject-dict enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}
^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:community\/friends\/fans-group\/artist\/group\/|mine\/applet\/redpoint|music\/songshare\/text\/recommend\/|resniche\/position\/play\/new\/|resniche\/tspopup\/show|resource\/comments?\/musiciansaid\/|user\/sub\/artist) reject-dict enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}
^https?:\/\/interface\d?\.music\.163\.com\/eapi\/(?:ios\/version|mlivestream\/entrance\/playpage\/|link\/position\/show\/strategy|link\/scene\/show\/resource|v1\/content\/exposure\/comment\/banner\/) reject-dict enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}
^https?:\/\/interface\d?\.music\.163.com\/w?e?api\/search\/default mock-response-body data-type=text enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}
^https?:\/\/interface\d?\.music\.163\.com\/w?eapi\/(?:activity\/bonus\/playpage\/time\/query|resource-exposure\/|search\/(?:chart\/|rcmd\/keyword\/|specialkeyword\/)) reject-dict enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}
^https:\/\/interface\d\.music\.163\.com\/eapi\/my\/podcast\/tab\/recommend reject-dict enable={ENABLE_NEMUSIC}&{NEMUSIC_ADBLOCK_ENABLE}

[MitM]
hostname = %APPEND% music.163.com, interface*.music.163.com, interfaced.music.163.com
