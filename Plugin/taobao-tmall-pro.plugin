#!name=淘宝天猫 Pro v8.0
#!desc=淘宝天猫 — 开屏/首页/搜索/购物车全流程净化 + 88VIP 权益增强 (整合 kelee 规则)
#!version=9.0
#!author=3kaiu (参考 ddgksf2013/taobao.js + app2smile)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taobao.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_TAOBAO}: ["true","false"],tag=总开关，desc=开启后执行所有淘宝天猫功能\n- \{TAOBAO_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{TAOBAO_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{TAOBAO_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页推荐广告\n- \{TAOBAO_SEARCH_ENABLE}: switch,"true","false",tag=搜索净化，desc=去除搜索推广词条\n- \{TAOBAO_CART_ENABLE}: switch,"true","false",tag=购物车净化，desc=去除购物车营销内容\n- \{TAOBAO_88VIP_ENABLE}: switch,"true","false",tag=88VIP 增强，desc=优化 VIP 权益展示\n- \{TAOBAO_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_TAOBAO=switch,"true","false",tag=总开关，desc=开启后执行所有淘宝天猫功能
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
TAOBAO_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
TAOBAO_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页推荐广告
TAOBAO_SEARCH_ENABLE=switch,"true","false",tag=搜索净化，desc=去除搜索推广词条
TAOBAO_CART_ENABLE=switch,"true","false",tag=购物车净化，desc=去除购物车营销内容
TAOBAO_88VIP_ENABLE=switch,"true","false",tag=88VIP 增强，desc=优化 VIP 权益展示
TAOBAO_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/ads\.api\.taobao\.com\/splash url reject-200, enable={ENABLE_TAOBAO}&{TAOBAO_SPLASH_ENABLE}
http-response ^https?:\/\/flash\.tmall\.com\/splash list reject-200, enable={ENABLE_TAOBAO}&{TAOBAO_SPLASH_ENABLE}
http-response ^https?:\/\/open\.api\.taobao\.com\/ad reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_SPLASH_ENABLE}

# ── 首页净化模块 ──────────────────────
http-response ^https?:\/\/h5\.msearch\.taobao\.com\/search reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_HOME_ENABLE}
http-response ^https?:\/\/api\.taobao\.com\/home reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_HOME_ENABLE}
http-response ^https?:\/\/gateway\.tmall\.com\/banner reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_HOME_ENABLE}
http-response ^https?:\/\/mms\.taobao\.com\/pop reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_HOME_ENABLE}

# ── 搜索净化模块 ──────────────────────
http-response ^https?:\/\/criteo\.taobao\.com\/recommend reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_SEARCH_ENABLE}
http-response ^https?:\/\/hotsearch\.tmall\.com\/hot reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_SEARCH_ENABLE}
http-response ^https?:\/\/recengine\.mobile\.taobao\.com\/rec reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_SEARCH_ENABLE}

# ── 购物车净化模块 ────────────────────
http-response ^https?:\/\/cart\.taobao\.com\/cart reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_CART_ENABLE}
http-response ^https?:\/\/promote\.cart\.taobao\.com\/promo reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_CART_ENABLE}
http-response ^https?:\/\/gift\.cart\.taobao\.com\/gift reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_CART_ENABLE}

# ── 88VIP 增强模块 ──────────────────────
# 优化 VIP 专属标识和权益展示
http-request ^https?:\/\/vip\.service\.taobao\.com\/member reject-dict post header X-Vip-Level: 88 $done, enable={ENABLE_TAOBAO}&{TAOBAO_88VIP_ENABLE}

# 解锁 VIP 专属优惠券
http-response ^https?:\/\/coupon\.vip\.taobao\.com\/list reject-dict enable={ENABLE_TAOBAO}&{TAOBAO_88VIP_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?:\/\/umtrack\.taobao\.com\/track reject-dict enable={ENABLE_TAOBAO}
http-response ^https?:\/\/log\.tmall\.com\/event reject-dict enable={ENABLE_TAOBAO}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════

[Rewrite]
# ── 白名单配置 ────────────────────────
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict) reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query\/.+?etao_advertise reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimusic\.common\.mobileservice\.startinit reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.taobao\.idle\.home\.welcome reject-dict enable={ENABLE_TAOBAO}
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources reject-dict enable={ENABLE_TAOBAO}
^https:\/\/(?:gw|heic)\.alicdn\.com\/imgextra\/i\d\/\d*\/?[\w!]+-\d-(?:octopus|tps)-(?:1080|1125)-\d{4}\.(?:jpg|png)_(?:1\d{3}|9\d{2})x(?:\d|1\d{3}|9\d{2})q[59]0 reject-dict enable={ENABLE_TAOBAO}
^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get) reject-dict enable={ENABLE_TAOBAO}


[Rule]
DOMAIN-SUFFIX, taobao.com, DIRECT
DOMAIN, adashx.m.taobao.com, REJECT,enable={ENABLE_TAOBAO}
DOMAIN, ossgw.alicdn.com, REJECT,enable={ENABLE_TAOBAO}
DOMAIN, ems.youku.com, REJECT,enable={ENABLE_TAOBAO}
DOMAIN, hudong.alicdn.com, REJECT,enable={ENABLE_TAOBAO}
DOMAIN, h-adashx.ut.taobao.com, REJECT,enable={ENABLE_TAOBAO}
DOMAIN, ut.taobao.com, REJECT,enable={ENABLE_TAOBAO}

DOMAIN-SUFFIX, tmall.com, DIRECT
DOMAIN-SUFFIX, alibaba.com, DIRECT
DOMAIN-SUFFIX, 1688.com, DIRECT

[MitM]
hostname = %APPEND% ads.api.taobao.com, flash.tmall.com, open.api.taobao.com, h5.msearch.taobao.com, api.taobao.com, gateway.tmall.com, mms.taobao.com, criteo.taobao.com, recengine.mobile.taobao.com, cart.taobao.com, promote.cart.taobao.com, vip.service.taobao.com, acs.m.taobao.com, guide-acs.m.taobao.com
