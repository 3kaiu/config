#!name=微信 Pro v8.1
#!desc=微信 — 朋友圈/公众号/视频号/小程序全流程净化 + 功能增强 (整合 kelee 规则)
#!version=9.2
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

[Argument]
# 2026-09-29 移除 WECHAT_MINI_ENABLE(小程序净化): 它声明「小程序净化」, 但唯一消费它的是
#   一条 script-path 指向第三方 applet.js 的规则 —— 即它**从未真正管过任何东西**,
#   是仓库遗留的假开关(拨了没反应)。上游引用移除后它连假消费都没了, 故一并删除。
#   微信本体的公众号/朋友圈/视频号净化均为本地 Rewrite, 不受影响。
ENABLE_WECHAT=switch,"true","false",tag=总开关
WECHAT_FRIEND_ENABLE=switch,"true","false",tag=朋友圈净化
WECHAT_MP_ENABLE=switch,"true","false",tag=公众号净化
WECHAT_VIDEO_ENABLE=switch,"true","false",tag=视频号净化
WECHAT_SEARCH_ENABLE=switch,"true","false",tag=搜索净化
WECHAT_UNBLOCK_ENABLE=switch,"true","false",tag=外链解锁

[Script]
# 朋友圈广告
http-response ^https?:\/\/api\.weixin\.qq\.com\/cgi-bin\/appmsg url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_FRIEND_ENABLE}
http-response ^https?:\/\/new\.weixin\.qq\.com\/mp\/getappmsgad url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_FRIEND_ENABLE}
http-response ^https?:\/\/file\.weixin\.qq\.com\/cgi-bin\/appreadpage url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_FRIEND_ENABLE}

# 公众号广告
http-response ^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsg url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_MP_ENABLE}
http-response ^https?:\/\/biz\.weixin\.qq\.com\/cgi-bin\/biz\/tmpl\/tmpl url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_MP_ENABLE}
http-response ^https?:\/\/mp\.tencent\.news\/cgi-bin\/mp\/tmpl url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_MP_ENABLE}

# 视频号净化
http-response ^https?:\/\/channels\.video\.qq\.com\/channel url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_VIDEO_ENABLE}
http-response ^https?:\/\/channels\.video\.qq\.com\/(feed|recommend) url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_VIDEO_ENABLE}

# 小程序净化 (沿用 applet.js)

# 搜索净化
http-response ^https?:\/\/cgi\.wechat\.qq\.com\/(msg|search) url reject-dict, enable={ENABLE_WECHAT}&{WECHAT_SEARCH_ENABLE}

# 外链解锁
http-request ^https?:\/\/link\.zhihu\.com\/\?.* url 302 https://$4, enable={ENABLE_WECHAT}&{WECHAT_UNBLOCK_ENABLE}
http-request ^https?:\/\/url\.me\.qq\.com\/\?.* url 302 https://$4, enable={ENABLE_WECHAT}&{WECHAT_UNBLOCK_ENABLE}
http-request ^https?:\/\/go\.cc\.link\/\?.* url 302 https://$4, enable={ENABLE_WECHAT}&{WECHAT_UNBLOCK_ENABLE}

# 其他
http-response ^https?:\/\/pay\.wechat\.qq\.com\/cgi-bin\/commercial url reject-dict, enable={ENABLE_WECHAT}
http-response ^https?:\/\/cgi\.wechat\.qq\.com\/ad url reject-dict, enable={ENABLE_WECHAT}

# 公众号本地兜底 (沿用常规版规则)
http-response ^https?:\/\/api\.blibee\.com\/cvsnotify-api\/cvs\/notify\/app\/banner\/v\d+$ url reject-200, enable={ENABLE_WECHAT}&{WECHAT_MP_ENABLE}
http-response ^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query$ url reject-200, enable={ENABLE_WECHAT}&{WECHAT_MP_ENABLE}

# 定时任务

[Rule]
DOMAIN-SUFFIX, weixin.qq.com, DIRECT
DOMAIN-SUFFIX, wxs.qq.com, REJECT,enable={ENABLE_WECHAT}

DOMAIN-SUFFIX, weixin.com, DIRECT
DOMAIN-SUFFIX, qq.com, DIRECT

[Rewrite]
^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\? reject-dict enable={ENABLE_WECHAT}
^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword reject-dict enable={ENABLE_WECHAT}

[MitM]
hostname = %APPEND% api.weixin.qq.com, new.weixin.qq.com, file.weixin.qq.com, mp.weixin.qq.com, biz.weixin.qq.com, channels.video.qq.com, api.m.wechat.qq.com, pay.wechat.qq.com, cgi.wechat.qq.com, api.blibee.com, ucmp.sf-express.com
