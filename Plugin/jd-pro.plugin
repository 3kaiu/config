#!name=京东去广告 Pro v7.9
#!desc=京东 — 商城/领券/商品页/比价净化（内联 jq，零脚本依赖）
#!version=7.9
#!author=3kaiu (功能开关架构参考起点引擎模式)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/JD.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_JD}: ["true","false"],tag=总开关, desc=开启后执行所有京东功能\n- \{JD_MALL_ENABLE}: switch,"true","false",tag=逛商城，desc=净化商城推荐流\n- \{JD_COUPON_ENABLE}: switch,"true","false",tag=领券中心，desc=领取可用优惠券\n- \{JD_PRICE_ENABLE}: switch,"true","false",tag=比价工具，desc=价格监控与历史对比

[Argument]
ENABLE_JD=switch,"true","false",tag=总开关，desc=开启后执行所有京东功能
JD_MALL_ENABLE=switch,"true","false",tag=逛商城，desc=净化商城推荐流
JD_COUPON_ENABLE=switch,"true","false",tag=领券中心，desc=领取可用优惠券
JD_PRICE_ENABLE=switch,"true","false",tag=比价工具，desc=价格监控与历史对比

[Script]
# ═══════════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# v7.9 (2026-08 审计): http-response 脚本 → 内联 response-body-json-jq (.data = {})
# 行为等价 (JD.ts 仅清空 data 字段), 去掉脚本运行时依赖; 虚设 cron (无签到逻辑) 已移除
# ═══════════════════════════════════════════════

# 商城首页净化
http-response ^https?:\/\/(m|app)\.jd\.com\/(mind|item)/ response-body-json-jq '.data = {}', tag=商城净化，enable={ENABLE_JD}&{JD_MALL_ENABLE}

# 领券中心净化
http-response ^https?:\/\/api\.360buy\.com\/marketing\/window\/get_window_info response-body-json-jq '.data = {}', tag=领券净化，enable={ENABLE_JD}&{JD_COUPON_ENABLE}

# 商品详情页
http-response ^https?:\/\/(m|item)\.jd\.com\/item\/ response-body-json-jq '.data = {}', tag=商品页净化，enable={ENABLE_JD}

# 比价工具
http-response ^https?:\/\/p.360buy\.com\/price\/tower response-body-json-jq '.data = {}', tag=比价工具，enable={ENABLE_JD}&{JD_PRICE_ENABLE}

[Rule]
DOMAIN-SUFFIX,ad.jddg.com, DIRECT
DOMAIN-SUFFIX,bjzhnl.jd.com, DIRECT

[MitM]
hostname = %APPEND% jd.com, 360buy.com, m.jd.com, app.jd.com
