#!name=购物生活净化 Pro
#!desc=聚合: 大众点评/美团/闲鱼/菜鸟/WPS/贴吧 — 单插件统一总开关, 各 App 独立子开关
#!version=1.0
#!author=3kaiu (聚合器生成)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ShoppingBags.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag=🛍 购物生活净化

[Argument]
BEIKE_ENABLE=switch,"true","false",tag=是否开启贝壳找房净化,desc=贝壳找房去广告
BOOHEE_ENABLE=switch,"true","false",tag=是否开启薄荷健康净化,desc=薄荷健康去广告
DAMAI_ENABLE=switch,"true","false",tag=是否开启大麦净化,desc=大麦去广告
DINGDONGMAICAI_ENABLE=switch,"true","false",tag=是否开启叮咚买菜净化,desc=叮咚买菜去广告
EASYCHARGE_ENABLE=switch,"true","false",tag=是否开启e充电净化,desc=e充电去广告
FC_BOX_ENABLE=switch,"true","false",tag=是否开启丰巢净化,desc=丰巢去广告
FLYERTEA_ENABLE=switch,"true","false",tag=是否开启飞客净化,desc=飞客去广告
HANTINGHOTELS_ENABLE=switch,"true","false",tag=是否开启华住会净化,desc=华住会去广告
JDWAIMAI_ENABLE=switch,"true","false",tag=是否开启京东外卖净化,desc=京东外卖去广告
KUAIDI100_ENABLE=switch,"true","false",tag=是否开启快递100净化,desc=快递100去广告
LUCKINCOFFEE_ENABLE=switch,"true","false",tag=是否开启瑞幸咖啡净化,desc=瑞幸咖啡去广告
MAFENGWO_ENABLE=switch,"true","false",tag=是否开启马蜂窝净化,desc=马蜂窝去广告
MRHEMA_ENABLE=switch,"true","false",tag=是否开启盒马净化,desc=盒马去广告
PUPUMALL_ENABLE=switch,"true","false",tag=是否开启朴朴超市净化,desc=朴朴超市去广告
TAOBAOTRAVEL_ENABLE=switch,"true","false",tag=是否开启飞猪旅行净化,desc=飞猪旅行去广告
TMALLCAMPUS_ENABLE=switch,"true","false",tag=是否开启天猫校园净化,desc=天猫校园去广告
IMAICAI_ENABLE=switch,"true","false",tag=是否开启小象超市净化,desc=小象超市去广告
SHOPPING_ENABLE=switch,"true","false",tag=总开关,desc=关闭后整组净化全部停用
DIANPING_ENABLE=switch,"true","false",tag=是否开启大众点评去广告,desc=开启后深度净化点评首页信息流/推荐流等广告
MEITUAN_ENABLE=switch,"true","false",tag=是否开启美团去广告,desc=开启后深度净化美团首页/外卖/推荐等广告
CAINIAO_ENABLE=switch,"true","false",tag=是否开启菜鸟包裹去广告,desc=开启后将对菜鸟包裹App及小程序进行去广告和净化
WPS_ENABLE=switch,"true","false",tag=是否开启WPS去广告,desc=开启后净化广告及文档推荐
ENABLE_TIEBA=switch,"true","false",tag=总开关，desc=开启后执行所有贴吧功能

[Rule]
DOMAIN-SUFFIX,iyes.youku.com,REJECT
AND,((USER-AGENT,Cainiao4iPhone*), (DOMAIN,amdc.m.taobao.com)), REJECT, enable={SHOPPING_ENABLE}&{CAINIAO_ENABLE}
IP-CIDR,180.76.76.200/32,REJECT,no-resolve,enable={SHOPPING_ENABLE}&{ENABLE_TIEBA}
DOMAIN, trackercollect.ddxq.mobi, REJECT,enable={SHOPPING_ENABLE}&{DINGDONGMAICAI_ENABLE}
DOMAIN, ddfs-public.ddimg.mobi, REJECT,enable={SHOPPING_ENABLE}&{DINGDONGMAICAI_ENABLE}
DOMAIN, rttrack.ddxq.mobi, REJECT,enable={SHOPPING_ENABLE}&{DINGDONGMAICAI_ENABLE}
DOMAIN, adash-evone.echargenet.com, REJECT,enable={SHOPPING_ENABLE}&{EASYCHARGE_ENABLE}
DOMAIN, advert.mafengwo.cn, REJECT,enable={SHOPPING_ENABLE}&{MAFENGWO_ENABLE}

