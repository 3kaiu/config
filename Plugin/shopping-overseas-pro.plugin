#!name=海外购物支付净化工具箱 Pro v8.3
#!desc=Amazon/eBay/PayPal/AliExpress 全流程净化 + 价格追踪 + 优惠信息
#!version=8.3
#!author=3kaiu (参考 ddgksf2013/app2smile 等开源资源)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Shopping.png

#!arguments-desc=\n- \{ENABLE_SHOPPING}: ["true","false"],tag=总开关，desc=开启后执行所有海外购物应用净化\n- \{SHOPPING_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{AMAZON_ENABLE}: switch,"true","false",tag Amazon 净化，desc=推荐广告净化 + 优惠券优化\n- \{EBAY_ENABLE}: switch,"true","false",tag eBay 净化，desc=搜索结果净化 + 广告过滤\n- \{PAYPAL_ENABLE}: switch,"true","false",tag PayPal 净化，desc=界面净化 + 营销推广去除\n- \{ALIEXPRESS_ENABLE}: switch,"true","false",tag AliExpress 净化，desc=推荐净化 + 促销优化\n- \{PRICE_ENABLE}: switch,"true","false",tag 价格追踪，desc=历史价格查询 + 降价提醒\n- \{PRIVACY_ENABLE}: switch,"true","false",tag隐私防护，desc=拦截购物追踪和数据收集\n- \{DEBUG_ENABLE}: switch,"false","true",tag调试模式，desc=输出详细执行日志

[Argument]
ENABLE_SHOPPING=switch,"true","false",tag=总开关，desc=开启后执行所有海外购物应用净化
SHOPPING_CRON_EXP=input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
AMAZON_ENABLE=switch,"true","false",tag Amazon 净化，desc=推荐广告净化 + 优惠券优化
EBAY_ENABLE=switch,"true","false",tag eBay 净化，desc=搜索结果净化 + 广告过滤
PAYPAL_ENABLE=switch,"true","false",tag PayPal 净化，desc=界面净化 + 营销推广去除
ALIEXPRESS_ENABLE=switch,"true","false",tag AliExpress 净化，desc=推荐净化 + 促销优化
PRICE_ENABLE=switch,"true","false",tag 价格追踪，desc=历史价格查询 + 降价提醒
PRIVACY_ENABLE=switch,"true","false",tag 隐私防护，desc=拦截购物追踪和数据收集
DEBUG_ENABLE=switch,"false","true",tag 调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🛒 Amazon 净化规则
# ════════════════════════════════════════

# ── 首页推荐净化 ───────────────────────
http-response ^https?:\/\/api\.atlas\.amazon\.com home-recommend-clean, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}
http-response ^https?:::\/\/www\.amazon\.com/gp/fma feed-clean, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}

# ── 搜索结果净化 ───────────────────────
http-response ^https?:\/\/api\.dn7\.amazonaws\.com search-result-clean, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}
http-response ^https?:::\/\/www\.amazon\.com/s sponsored-filter, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}

# ── 商品详情净化 ───────────────────────
http-response ^https?:\/\/dp\.images\.amazon\.com product-recommend-clean, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}
http-response ^https?:::\/\/www\.amazon\.com/dp also-buy-filter, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}

# ── 购物车/结算净化 ───────────────────
http-response ^https?:\/\/api\.na\.results\.amazon\.com cart-clean, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}
http-response ^https?:::\/\/www\.amazon\.com/ap/cart upsell-filter, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}

# ── 优惠券优化 ──────────────────────────
http-response ^https?:\/\/coupons\.amazon\.com coupon-enhance, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}
http-response ^https?:::\/\/www\.amazon\.com/bundle bundle-deals-filter, enable={ENABLE_SHOPPING}&{AMAZON_ENABLE}

# ═══════════════════════════════════════===
# 🏷️ eBay 净化规则
# ═══════════════════════════════════════===

# ── 搜索结果净化 ───────────────────────
http-response ^https?:\/\/api\.ebay\.com search-ad-block, enable={ENABLE_SHOPPING}&{EBAY_ENABLE}
http-response ^https?::\":\"\"\"www\.ebay\.com\/sch sponsored-products-filter, enable={ENABLE_SHOPPING}&{EBAY_ENABLE}

# ── 商品页面净化 ───────────────────────
http-response ^https?:\/\/api\.ebay\.com\/restads product-ad-clean, enable={ENABLE_SHOPPING}&{EBAY_ENABLE}
http-response ^https?::\":\"\"\"www\.ebay\.com\/itm cross-sell-filter, enable={ENABLE_SHOPPING}&{EBAY_ENABLE}

# ── 购物车净化 ──────────────────────────
http-response ^https?:\/\/api\.ebay\.com\/cart cart-ad-block, enable={ENABLE_SHOPPING}&{EBAY_ENABLE}
http-response ^https?::\":\"\"\"signin\.ebay\.com\/ws\/eBayISAPI\.dll upsell-filter, enable={ENABLE_SHOPPING}&{EBAY_ENABLE}

# ═══════════════════════════════════════===
# 💳 PayPal 净化规则
# ═══════════════════════════════════════===

# ── 主页净化 ────────────────────────────
http-response ^https?:\/\/www\.paypal\.com/home promo-clean, enable={ENABLE_SHOPPING}&{PAYPAL_ENABLE}
http-response ^https?::\":\"\"\"www\.paypal\.com\/webapps marketing-filter, enable={ENABLE_SHOPPING}&{PAYPAL_ENABLE}

# ── 交易流程净化 ───────────────────────
http-response ^https?:\/\/api\.paypal\.com transaction-promo-clean, enable={ENABLE_SHOPPING}&{PAYPAL_ENABLE}
http-response ^https?::\":\"\"\"www\.paypal\.com\/checkout upsell-filter, enable={ENABLE_SHOPPING}&{PAYPAL_ENABLE}

# ── 通知推送净化 ───────────────────────
http-response ^https?:\/\/www\.paypal\.com notifications-clean, enable={ENABLE_SHOPPING}&{PAYPAL_ENABLE}
http-response ^https?::\":\"\"\"www\.paypal\.com\/messages message-ad-filter, enable={ENABLE_SHOPPING}&{PAYPAL_ENABLE}

# ═══════════════════════════════════════===
# 🌍 AliExpress 净化规则
# ═══════════════════════════════════════===

# ── 首页推荐净化 ───────────────────────
http-response ^https?:\/\/recommendation\.aliexpress\.com home-recommend-clean, enable={ENABLE_SHOPPING}&{ALIEXPRESS_ENABLE}
http-response ^https?::\":\"\"\"www\.aliexpress\.com promotion-clear, enable={ENABLE_SHOPPING}&{ALIEXPRESS_ENABLE}

# ── 搜索结果净化 ───────────────────────
http-response ^https?:\/\/alimama\.web\.api\.taobao\.com search-filter, enable={ENABLE_SHOPPING}&{ALIEXPRESS_ENABLE}
http-response ^https?::\":\"\"\"www\.aliexpress\.com\/item sponsored-filter, enable={ENABLE_SHOPPING}&{ALIEXPRESS_ENABLE}

# ── 商品详情净化 ───────────────────────
http-response ^https?:\/\/sku\.service\.aliexpress\.com product-ad-clean, enable={ENABLE_SHOPPING}&{ALIEXPRESS_ENABLE}
http-response ^https?::\":\"\"\"productkey\.service\.aliexpress\.com related-filter, enable={ENABLE_SHOPPING}&{ALIEXPRESS_ENABLE}

# ═══════════════════════════════════════===
# 💰 价格追踪增强
# ═══════════════════════════════════════===

# ── 历史价格查询 ───────────────────────
http-response ^https?:\/\/camelcamelcamel\.com price-history-track, enable={ENABLE_SHOPPING}&{PRICE_ENABLE}
http-response ^https?::\":\"\"\"keepa\.com price-chart-fetch, enable={ENABLE_SHOPPING}&{PRICE_ENABLE}

# ── 降价提醒设置 ────────────────────────
http-response ^https?:\/\/api\.pricealert\.com alert-setup, enable={ENABLE_SHOPPING}&{PRICE_ENABLE}
http-response ^https?::\":\"\"\"www\.camelcamelcamel\.com deal-alert, enable={ENABLE_SHOPPING}&{PRICE_ENABLE}

# ═══════════════════════════════════════===
# 🔒 购物隐私防护
# ═══════════════════════════════════════===

# ── 行为追踪拦截 ───────────────────────
http-request ^https?:\/\/pixel\.amazon\.com amazon-behavior-blocker, enabled={ENABLE_SHOPPING}&{PRIVACY_ENABLE}
http-request ^https?::\":\"\"\"www\.ebay\.com\/analytics ebay-behavior-blocker, enabled={ENABLE_SHOPPING}&{PRIVACY_ENABLE}

# ── Cookie 管理 ──────────────────────────
http-response ^https?:\/\/www\.amazon\.com/cookies consent-banner-clean, enabled={ENABLE_SHOPPING}
http-response ^https?::\":\"\"\"www\.ebay\.com\/cookies cookie-preference-filter, enabled={ENABLE_SHOPPING}

# ── 第三方追踪器拦截 ───────────────────
http-request ^https?::\":\"\"\"tracking\.facebook\.com fb-pixel-blocker, enabled={ENABLE_SHOPPING}&{PRIVACY_ENABLE}
http-request ^https?::\":\"\"\"google-analytics\.com ga-tracking-blocker, enabled={ENABLE_SHOPPING}&{PRIVACY_ENABLE}

# ═══════════════════════════════════════===
# ⏰ Cron 定时任务（可选功能）
# ═══════════════════════════════════════===
cron {SHOPPING_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/ShoppingServices.js, timeout={TIMEOUT}, tag=海外购物服务定时优化，argument=[{DEBUG_ENABLE}], enabled={ENABLE_SHOPPING}

[Rewrite]
# ── 白名单配置 ─────────────────────────
DOMAIN-SUFFIX, amazon.com, DIRECT
DOMAIN-SUFFIX, ebay.com, DIRECT
DOMAIN-SUFFIX, paypal.com, DIRECT
DOMAIN-SUFFIX, aliexpress.com, DIRECT

[MitM]
hostname = %APPEND% api.atlas.amazon.com, www.amazon.com, dp.images.amazon.com, api.dn7.amazonaws.com, api.ebay.com, signin.ebay.com/ws/eBayISAPI.dll, www.paypal.com, api.paypal.com, recommendation.aliexpress.com, alimama.web.api.taobao.com, sku.service.aliexpress.com, productkey.service.aliexpress.com, pixel.amazon.com, tracking.facebook.com
