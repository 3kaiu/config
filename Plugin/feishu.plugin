#!name=飞书去广告
#!desc=飞书/Lark - 信息流推广过滤 + 推荐位 banner_ad 清空 (internal-api.feishu.cn / open.feishu.cn)
#!version=1.0
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Feishu.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

[Argument]
FEISHU_ENABLE=switch,"true","false",tag=飞书去广告总开关,desc=开启后净化信息流推广与推荐位广告

[Script]
# 信息流推广过滤 (internal-api.feishu.cn)
http-response ^https?:\/\/internal-api\.feishu\.cn\/.*\/feed script-path=https://ws.wenn.in/main/Scripts/Feishu.js, requires-body=true, timeout=60, tag=信息流净化, enable={FEISHU_ENABLE}
# 推荐位 banner_ad 清空 (open.feishu.cn)
http-response ^https?:\/\/open\.feishu\.cn\/.*\/recommend script-path=https://ws.wenn.in/main/Scripts/Feishu.js, requires-body=true, timeout=60, tag=推荐位净化, enable={FEISHU_ENABLE}

[MitM]
hostname = %APPEND% internal-api.feishu.cn, open.feishu.cn
