#!name=滴滴出行 Pro v8.2
#!desc=滴滴 — 开屏/首页/行程/乘车全流程净化 + 优惠券管理 (整合 kelee 规则)
#!version=9.2
#!author=3kaiu (参考 ddgksf2013/didi.js + app2smile)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/DiDi.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_DIDI}: ["true","false"],tag=总开关，desc=开启后执行所有滴滴功能\n- \{DIDI_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{DIDI_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{DIDI_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页推荐广告\n- \{DIDI_ORDER_ENABLE}: switch,"true","false",tag=订单净化，desc=去除订单页营销\n- \{DIDI_COUPON_ENABLE}: switch,"true","false",tag=优惠券管理，desc=优化优惠券展示\n- \{DIDI_VIP_ENABLE}: switch,"true","false",tag=D 豆会员，desc=D 豆权益增强\n- \{DIDI_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_DIDI=switch,"true","false",tag=总开关，desc=开启后执行所有滴滴功能
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
DIDI_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
DIDI_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页推荐广告
DIDI_ORDER_ENABLE=switch,"true","false",tag=订单净化，desc=去除订单页营销
DIDI_COUPON_ENABLE=switch,"true","false",tag=优惠券管理，desc=优化优惠券展示
DIDI_VIP_ENABLE=switch,"true","false",tag=D 豆会员，desc=D 豆权益增强
DIDI_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/ads\.didiglobal\.com\/splash reject-dict enable={ENABLE_DIDI}&{DIDI_SPLASH_ENABLE}
http-response ^https?:\/\/sdkopen\.vip\.didi\.cn\/splash reject-dict enable={ENABLE_DIDI}&{DIDI_SPLASH_ENABLE}
http-response ^https?:\/\/mbs\.didiglobal\.com\/splash reject-dict enable={ENABLE_DIDI}&{DIDI_SPLASH_ENABLE}

# ── 首页净化模块 ──────────────────────
http-response ^https?:\/\/api\.didiglobal\.com\/gateway reject-dict enable={ENABLE_DIDI}&{DIDI_HOME_ENABLE}
http-response ^https?:\/\/portal\.didiglobal\.com\/portal reject-dict enable={ENABLE_DIDI}&{DIDI_HOME_ENABLE}
http-response ^https?:\/\/news\.didiglobal\.com\/feed reject-dict enable={ENABLE_DIDI}&{DIDI_HOME_ENABLE}
http-response ^https?:\/\/recommend\.didi\.cn\/rec reject-dict enable={ENABLE_DIDI}&{DIDI_HOME_ENABLE}

# ── 订单净化模块 ──────────────────────
http-response ^https?:\/\/order\.didi\.cn\/promo reject-dict enable={ENABLE_DIDI}&{DIDI_ORDER_ENABLE}
http-response ^https?:\/\/invoice\.didiglobal\.com\/gift reject-dict enable={ENABLE_DIDI}&{DIDI_ORDER_ENABLE}
http-response ^https?:\/\/receipt\.didi\.cn\/discount reject-dict enable={ENABLE_DIDI}&{DIDI_ORDER_ENABLE}

# ── 优惠券管理模块 ────────────────────
http-response ^https?:\/\/coupon\.didi\.cn\/popup reject-dict enable={ENABLE_DIDI}&{DIDI_COUPON_ENABLE}
# v8.2 (2026-08 审计): ^https?: 全局捕获会作用于其它插件域并掩盖 MitM 孤儿判定, 收窄到 didi 域名
http-response ^https?:\/\/[^\/]*(didiglobal\.com|didi\.cn) reject-dict voucher-filter, enable={ENABLE_DIDI}&{DIDI_COUPON_ENABLE}
http-response ^https?:\/\/ticket\.didi\.cn\/promotion reject-dict enable={ENABLE_DIDI}&{DIDI_COUPON_ENABLE}

# ── D 豆会员增强模块 ──────────────────
# 优化 D 豆积分显示和兑换
http-request ^https?:\/\/points\.didi\.cn\/level reject-dict post header X-DPoints: premium $done, enable={ENABLE_DIDI}&{DIDI_VIP_ENABLE}

# 解锁会员专属优惠
http-response ^https?:\/\/member\.didi\.cn\/vip reject-dict enable={ENABLE_DIDI}&{DIDI_VIP_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?:\/\/tracking\.didi\.cn\/track reject-dict enable={ENABLE_DIDI}
http-response ^https?:\/\/log\.didiglobal\.com\/event reject-dict enable={ENABLE_DIDI}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════

[Rewrite]
# ── 白名单配置 ────────────────────────
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget reject-dict enable={ENABLE_DIDI}
^https:\/\/lion\.didialift\.com\/broker\/\? reject-dict enable={ENABLE_DIDI}
^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/slow\? reject-dict enable={ENABLE_DIDI}
^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/core\? response-body-json-jq '.data.disorder_cards.bottom_nav_list.data |= map(select(.id == "home_page" or .id == "user_center")) | .data.order_cards.nav_list_card.data |= map(select(.nav_id == "dache_anycar" or .nav_id == "carmate" or .nav_id == "driverservice" or .nav_id == "zhandianbashi" or .nav_id == "yuancheng" or .nav_id == "pincheche" or .nav_id == "bike" or .nav_id == "special_ride" or .nav_id == "nav_more_v3"))' enable={ENABLE_DIDI}
^https:\/\/conf\.diditaxi\.com\.cn\/homepage\/v1\/other\/fast\? response-body-json-del data.disorder_cards.communicate_card data.disorder_cards.not_login_bottom_bar data.disorder_cards.riding_code_card data.order_cards.car_owner_widget_card data.order_cards.marketing_card data.order_cards.super_banner_card data.disorder_cards.car_icon.data.icon_info_new_agreement enable={ENABLE_DIDI}
^https:\/\/res\.xiaojukeji\.com\/resapi\/activity\/mget\? response-body-json-del data.mult_home_banner enable={ENABLE_DIDI}
^https:\/\/common\.diditaxi\.com\.cn\/common\/v5\/usercenter\/layout$ response-body-json-jq '.data |= (.instances |= (to_entries | map(select(.key as $k | ["center_base_info_card", "center_tool_card", "center_wallet_finance_card", "center_order_related_card"] | index($k))) | from_entries)) | .data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == "优惠卡券" or .title == "余额" or .title == "福利金"))' enable={ENABLE_DIDI}
^https:\/\/ct\.xiaojukeji\.com\/agent\/v3\/feeds\? reject-dict enable={ENABLE_DIDI}
^https:\/\/conf\.diditaxi\.com\.cn\/dynamic\/conf reject-dict enable={ENABLE_DIDI}
^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/dache_homepage_layout\? response-body-json-jq '.data |= (.instances |= (to_entries | map(select(.key | test("feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_"))) | from_entries))' enable={ENABLE_DIDI}
^https:\/\/api\.udache\.com\/gulfstream\/porsche\/v1\/pSFCHomePage\? response-body-json-jq '.data |= (if . == null then null else {hot_route_info, legal_info} end) | . as $root | .data.tab_list = ($root.data.tab_list | map(select(.tab_id == "passenger")))' enable={ENABLE_DIDI}
^https:\/\/poi\.map\.xiaojukeji\.com\/mapapi\/recommend\? reject-dict enable={ENABLE_DIDI}
^https:\/\/daijia\.kuaidadi\.com:443\/gateway\? response-body-json-del data.variantInfo enable={ENABLE_DIDI}
^https:\/\/daijia\.kuaidadi\.com:443\/gateway\? response-body-json-jq '.data |= with_entries(select(.value.isAd != 1))' enable={ENABLE_DIDI}
^https:\/\/api\.udache\.com\/intercity\/ticket\/api\/v1\/core\/getFullPageInfoLayout\? response-body-json-jq '.data.disorder_components |= (map(select(.name == "history_order_card" or .name == "inprogress_order_card" or .name == "station_calendar" or .name == "main_card_v2" or .name == "user_history_order")))' enable={ENABLE_DIDI}
^https:\/\/htwkop\.xiaojukeji\.com:443\/gateway\? response-body-json-del data.didi-bike-homepage-popup data.variantInfo enable={ENABLE_DIDI}
^https:\/\/as\.xiaojukeji\.com\/ep\/as\/toggles\? response-body-json-jq '.data |= map(if .name|IN("daijia_journey_new_tcp_switch","daijia_tcp_init","daijia_tcp_msg_encrypt","daijia_tcp_site_info","daijia_tcp_site_report")then.allow=false else. end)' enable={ENABLE_DIDI}


[Rule]
DOMAIN-SUFFIX, didiglobal.com, DIRECT
DOMAIN, gwp.xiaojukeji.com, REJECT,enable={ENABLE_DIDI}
AND, ((IP-ASN, 45090, no-resolve), (DEST-PORT, 25641), (PROTOCOL, TCP)), REJECT,enable={ENABLE_DIDI}
AND, ((IP-ASN, 55990, no-resolve), (DEST-PORT, 25641), (PROTOCOL, TCP)), REJECT,enable={ENABLE_DIDI}
AND, ((IP-ASN, 63646, no-resolve), (DEST-PORT, 25641), (PROTOCOL, TCP)), REJECT,enable={ENABLE_DIDI}

DOMAIN-SUFFIX, didi.cn, DIRECT
DOMAIN-SUFFIX, didi.com, DIRECT

[MitM]
hostname = %APPEND% ads.didiglobal.com, sdkopen.vip.didi.cn, mbs.didiglobal.com, api.didiglobal.com, portal.didiglobal.com, news.didiglobal.com, recommend.didi.cn, order.didi.cn, invoice.didiglobal.com, receipt.didi.cn, coupon.didi.cn, vouchers.didiglobal.com, ticket.didi.cn, points.didi.cn, member.didi.cn, res.xiaojukeji.com, lion.didialift.com, conf.diditaxi.com.cn, common.diditaxi.com.cn, ct.xiaojukeji.com, api.udache.com, poi.map.xiaojukeji.com, daijia.kuaidadi.com, htwkop.xiaojukeji.com, as.xiaojukeji.com
