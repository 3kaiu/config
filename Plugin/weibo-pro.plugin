#!name=微博去广告 Pro v9.0
#!desc=微博 — 开屏/信息流/热搜/评论区全流程净化 + 功能模块控制 (整合 kelee 规则 + 墨鱼脚本)
#!version=10.0
#!author=3kaiu (参考 ddgksf2013/WeiboAds.conf + app2smile + zmqcherish)
#!homepage=https://github.com/3kaiu/config
#!icon=https://icons.duckduckgo.com/ip3/api.weibo.cn.ico
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_WEIBO}: ["true","false"],tag=总开关，desc=开启后执行所有微博功能\n- \{WEIBO_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{WEIBO_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{WEIBO_FEED_ENABLE}: switch,"true","false",tag=信息流净化，desc=去除首页/关注页推荐广告\n- \{WEIBO_HOTEnable}: switch,"true","false",tag=热搜净化，desc=去除热搜推广词条\n- \{WEIBO_COMMENT_ENABLE}: switch,"true","false",tag=评论区净化，desc=去除评论广告/推广\n- \{WEIBO_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_WEIBO=switch,"true","false",tag=总开关，desc=开启后执行所有微博功能
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
WEIBO_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
WEIBO_FEED_ENABLE=switch,"true","false",tag=信息流净化，desc=去除首页/关注页推荐广告
WEIBO_HOT_ENABLE=switch,"true","false",tag=热搜净化，desc=去除热搜推广词条
WEIBO_COMMENT_ENABLE=switch,"true","false",tag=评论区净化，desc=去除评论广告/推广
WEIBO_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/ads\.api\.weibo\.com\/app\/splash url reject-200, enable={ENABLE_WEIBO}&{WEIBO_SPLASH_ENABLE}
http-response ^https?:\/\/flash\.weibo\.com\/splash\/list url reject-200, enable={ENABLE_WEIBO}&{WEIBO_SPLASH_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/splash url reject-200, enable={ENABLE_WEIBO}&{WEIBO_SPLASH_ENABLE}

# ── 信息流净化模块 ────────────────────
http-response ^https?:\/\/api\.weibo\.cn\/2\/statusmates\/feed reject-dict enable={ENABLE_WEIBO}&{WEIBO_FEED_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/unreadflow reject-dict enable={ENABLE_WEIBO}&{WEIBO_FEED_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/timeline reject-dict enable={ENABLE_WEIBO}&{WEIBO_FEED_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/favoritelist reject-dict enable={ENABLE_WEIBO}&{WEIBO_FEED_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/comments\/build_comment reject-dict enable={ENABLE_WEIBO}&{WEIBO_FEED_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/comments\/hotcomment reject-dict enable={ENABLE_WEIBO}&{WEIBO_FEED_ENABLE}

# ── 热搜净化模块 ──────────────────────
http-response ^https?:\/\/api\.weibo\.cn\/2\/hot_search reject-dict enable={ENABLE_WEIBO}&{WEIBO_HOT_ENABLE}
http-response ^https?:\/\/top\.weibo\.com\/rest\/db\/v2\/search reject-dict enable={ENABLE_WEIBO}&{WEIBO_HOT_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/hotsearch reject-dict enable={ENABLE_WEIBO}&{WEIBO_HOT_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/top\/100 reject-dict enable={ENABLE_WEIBO}&{WEIBO_HOT_ENABLE}

# ── 评论区净化模块 ───────────────────
http-response ^https?:\/\/api\.weibo\.cn\/2\/comments\/show reject-dict enable={ENABLE_WEIBO}&{WEIBO_COMMENT_ENABLE}
http-response ^https?:\/\/api\.weibo\.cn\/2\/comments\/compatible reject-dict comment-filter, enable={ENABLE_WEIBO}&{WEIBO_COMMENT_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?:\/\/api\.weibo\.cn\/2\/ad\/home reject-dict enable={ENABLE_WEIBO}
http-response ^https?:\/\/api\.weibo\.cn\/2\/topic\/recommend reject-dict enable={ENABLE_WEIBO}
http-response ^https?:\/\/api\.weibo\.cn\/2\/page/ad reject-dict enable={ENABLE_WEIBO}
http-response ^https?:\/\/api\.weibo\.cn\/2\/profile\/info reject-dict enable={ENABLE_WEIBO}
http-response ^https?:\/\/api\.weibo\.cn\/2\/client\/ads reject-dict enable={ENABLE_WEIBO}

# ════════════════════════════════════════
# 📝 墨鱼脚本净化 (响应体 JSON 清洗)
# ════════════════════════════════════════

# ── 信息流 (removeTimeLine) ──
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/friends\/timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_信息流
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses_unread_hot_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_热门时间线
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/unread_friends_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_好友时间线
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_热门时间线2
http-response ^https?:\/\/api\.weibo\.cn\/2\/groups\/timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_分组时间线
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/friends_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_好友时间线2

# ── 卡片列表 (removeCards) ──
http-response ^https?:\/\/api\.weibo\.cn\/2\/cardlist script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_卡片列表
http-response ^https?:\/\/api\.weibo\.cn\/2\/video\/community_tab script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_视频社区
http-response ^https?:\/\/api\.weibo\.cn\/2\/searchall script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_搜索全部

# ── 个人页/详情/搜索/超话 ──
http-response ^https?:\/\/api\.weibo\.cn\/2\/profile\/me script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_个人页
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/extend script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_详情
http-response ^https?:\/\/api\.weibo\.cn\/2\/search\/finder script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_搜索主页
http-response ^https?:\/\/api\.weibo\.cn\/2\/search\/container_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_搜索时间线
http-response ^https?:\/\/api\.weibo\.cn\/2\/search\/container_discover script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_搜索发现
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/unread_topic_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_超话时间线
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline_topic script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_超话容器
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/container_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_容器时间线

# ── 开屏广告 ──
http-response ^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_开屏SDK
http-response ^https?:\/\/api\.weibo\.cn\/2\/ad\/preload script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_广告预加载
http-response ^https?:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_实时广告

# ── 其他功能模块 ──
http-response ^https?:\/\/api\.weibo\.cn\/2\/video\/remind_info script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_视频提醒
http-response ^https?:\/\/api\.weibo\.cn\/2\/checkin\/show script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_签到
http-response ^https?:\/\/api\.weibo\.cn\/2\/live\/media_homelist script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_直播
http-response ^https?:\/\/api\.weibo\.cn\/2\/container_detail script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_容器详情
http-response ^https?:\/\/api\.weibo\.cn\/2\/container\/get_item script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_容器项
http-response ^https?:\/\/api\.weibo\.cn\/2\/profile\/container_timeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_用户时间线
http-response ^https?:\/\/api\.weibo\.cn\/2\/video\/tiny_stream_video_list script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_视频列表
http-response ^https?:\/\/api\.weibo\.cn\/2\/statuses\/video_mixtimeline script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_视频混合
http-response ^https?:\/\/api\.weibo\.cn\/2\/flowpage script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_消息流
http-response ^https?:\/\/api\.weibo\.cn\/2\/page script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_页面
http-response ^https?:\/\/api\.weibo\.cn\/square.*&pageDataType script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_广场
http-response ^https?:\/\/api\.weibo\.cn\/2\/!\/client\/light_skin script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_主题皮肤
http-response ^https?:\/\/api\.weibo\.cn\/2\/littleskin\/preview script-path=https://ws.wenn.in/main/Scripts/Weibo.js, requires-body=true, timeout=10, tag=微博_皮肤预览

[Rewrite]
# ── 白名单配置 ────────────────────────
^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info) reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/photo\/info\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info) reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category) reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\? reject-dict enable={ENABLE_WEIBO}
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime reject-dict enable={ENABLE_WEIBO}
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) reject-dict enable={ENABLE_WEIBO}
^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead) reject-dict enable={ENABLE_WEIBO}
^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead) reject-dict enable={ENABLE_WEIBO}


# ── 特殊域名重定向 ──────────────────
^https?:\/\/t\.co\/\?(https?)?(%3A|:)?(\/\/|%2F%2F)?(.*)$ 302 https://$4 enable={ENABLE_WEIBO}

[Rule]
DOMAIN-SUFFIX, weibo.com, DIRECT
DOMAIN-SUFFIX, uve.weibo.com, DIRECT,enable={ENABLE_WEIBO}
DOMAIN, huodong.weibo.cn, REJECT,enable={ENABLE_WEIBO}
DOMAIN-SUFFIX, biz.weibo.com, REJECT,enable={ENABLE_WEIBO}

DOMAIN-SUFFIX, weibocdn.com, DIRECT

[MitM]
hostname = %APPEND% api.weibo.cn, api.weibo.com, ads.weibo.com, flash.weibo.com, top.weibo.com, mapi.weibo.com, mapi.weibo.cn, new.vip.weibo.cn, boot.biz.weibo.com, bootrealtime.uve.weibo.com, sdkapp.uve.weibo.com, card.weibo.com, weibo.com
