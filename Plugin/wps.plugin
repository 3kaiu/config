#!name=WPS去广告
#!desc=WPS Office - 广告/文档推荐净化
#!version=7.8
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/WPS.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

[Argument]
WPS_ENABLE=switch,"true","false",tag=是否开启WPS去广告,desc=开启后净化广告及文档推荐

[Script]
http-response ^https?:\/\/adservice\.wps\.cn\/ script-path=https://ws.wenn.in/main/Scripts/WPS.js, requires-body=true, timeout=10, tag=WPS_广告拦截, enable={WPS_ENABLE}
http-response ^https?:\/\/docer\.wps\.cn\/ script-path=https://ws.wenn.in/main/Scripts/WPS.js, requires-body=true, timeout=10, tag=WPS_文档推荐净化, enable={WPS_ENABLE}

[MitM]
hostname = %APPEND% adservice.wps.cn, docer.wps.cn
