#!name=B 站去广告 Pro v7.9
#!desc=B 站 — 首页/视频推荐/直播/动态全流程净化 + 高清画质解锁
#!version=7.9
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bilibili.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

[Argument]
ENABLE_BILI=switch,"true","false",tag=总开关
BILI_CRON_EXP=input,"0 12 * * *",tag=Cron 表达式
TIMEOUT=input,60,tag=超时时间 (秒)
BILI_SPLASH_ENABLE=switch,"true","false",tag=开屏广告
BILI_FEED_ENABLE=switch,"true","false",tag=信息流净化
BILI_LIVE_ENABLE=switch,"true","false",tag=直播净化
BILI_DYNAMIC_ENABLE=switch,"true","false",tag=动态净化
BILI_1080P_ENABLE=switch,"true","false",tag=高清画质解锁
BILI_DEBUG_ENABLE=switch,"false","true",tag=调试模式

[Script]
# 开屏广告
http-response ^https?:\/\/api\.bilibili\.com\/x\/app\/home\/splash url reject-200, enable={ENABLE_BILI}&{BILI_SPLASH_ENABLE}
http-response ^https?:\/\/mobi\.bilibili\.com\/open\/splash list reject-200, enable={ENABLE_BILI}&{BILI_SPLASH_ENABLE}

# 信息流净化
http-response ^https?:\/\/api\.bilibili\.com\/x\/(web-interface\/home|feed-section\/section|ad\/home) script-path=https://ws.wenn.in/main/Mirror/bilibili-json.js, requires-body=true, timeout=10, tag=去广告, enable={ENABLE_BILI}&{BILI_FEED_ENABLE}
http-response ^https?:\/\/api\.bilibili\.com\/x\/web-interface\/nav url reject-dict, enable={ENABLE_BILI}&{BILI_FEED_ENABLE}
http-response ^https?:\/\/api\.bilibili\.com\/pgc\/season\/home url reject-dict, enable={ENABLE_BILI}&{BILI_FEED_ENABLE}
http-response ^https?:\/\/api\.bilibili\.com\/x\/v2\/rank url reject-dict, enable={ENABLE_BILI}&{BILI_FEED_ENABLE}

# Proto 去广告 (沿用常规版方案)
http-response ^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(viewunite\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll) script-path=https://ws.wenn.in/main/Mirror/bilibili-proto.js, binary-body-mode=true, requires-body=true, timeout=10, tag=Proto去广告, enable={ENABLE_BILI}&{BILI_FEED_ENABLE}

# 直播净化
http-response ^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v2\/room\/get_info url reject-dict, enable={ENABLE_BILI}&{BILI_LIVE_ENABLE}
http-response ^https?:\/\/api\.live\.bilibili\.com\/pay/v1\/Order\/get_gift_stream url reject-dict, enable={ENABLE_BILI}&{BILI_LIVE_ENABLE}

# 动态净化
http-response ^https?:\/\/api\.bilibili\.com\/x/polymer/web-dynamic/v1/feed\/tab url reject-dict, enable={ENABLE_BILI}&{BILI_DYNAMIC_ENABLE}
http-response ^https?:\/\/api\.bilibili\.com\/x/policy\/show-config url reject-dict, enable={ENABLE_BILI}&{BILI_DYNAMIC_ENABLE}

# 高清画质解锁
http-response ^https?:\/\/api\.bilibili\.com\/x\/interface\/wbi url reject-dict, enable={ENABLE_BILI}&{BILI_1080P_ENABLE}
http-response ^https?:\/\/api\.bilibili\.com\/pgc/player/web/playurl url reject-dict, enable={ENABLE_BILI}&{BILI_1080P_ENABLE}

# 定时任务
cron {BILI_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/Bilibili.js, timeout={TIMEOUT}, tag=B 站定时任务, enable={ENABLE_BILI}

[Rewrite]
# 港澳台地区解锁
request if ${url} ~= /^https?:\/\/app\.bilibili\.com\/(x\/)?(intl|dm|reply|history|v\d\/(fav|msgfeed)).+?(&s_locale=zh-Hans_[A-Z]{2})(.+?)(&sim_code=\d+)(.+)/i as urlMatch && ${ENABLE_BILI} == true then redirect(302, "${urlMatch.1}${urlMatch.2}${urlMatch.3}${urlMatch.4}${urlMatch.5}&s_locale=zh-Hans_PH&sim_code=51503${urlMatch.7}")
request if ${url} ~= /^https?:\/\/passport\.bilibili\.com\/x\/intl\/passport-login\/.+(&s_locale=zh-Hans_[A-Z]{2})(.+)(&sim_code=\d+)(.+)/i as urlMatch && ${ENABLE_BILI} == true then redirect(302, "${urlMatch.1}${urlMatch.2}&s_locale=zh-Hans_PH&sim_code=51503${urlMatch.4}")

[Rule]
DOMAIN-SUFFIX, bilibili.com, DIRECT
DOMAIN-SUFFIX, bilivideo.com, DIRECT
DOMAIN-SUFFIX, hdslb.com, DIRECT

[MitM]
hostname = %APPEND% api.bilibili.com, mobi.bilibili.com, live.bilibili.com, i0.hdslb.com, app.bilibili.com, grpc.biliapi.net
