#!name=小红书去广告 Pro v8.0
#!desc=小红书 — 开屏/信息流/搜索/水印去除全流程净化 + 功能模块控制
#!version=8.0
#!author=3kaiu (参考 ddgksf2013/XiaoHongShuAds.conf + app2smile)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/XiaoHongShu.png

#!arguments-desc=\n- \{ENABLE_XHS}: ["true","false"],tag=总开关，desc=开启后执行所有小红书功能\n- \{XHS_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,90,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{XHS_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{XHS_FEED_ENABLE}: switch,"true","false",tag=信息流净化，desc=去除首页推荐广告\n- \{XHS_SEARCH_ENABLE}: switch,"true","false",tag=搜索净化，desc=去除搜索推广词条\n- \{XHS_WATERMARK_ENABLE}: switch,"true","false",tag=去水印，desc=去除图片/视频水印\n- \{XHS_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_XHS=switch,"true","false",tag=总开关，desc=开启后执行所有小红书功能
XHS_CRON_EXP=input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）
TIMEOUT=input,90,tag=超时时间 (秒), desc=脚本最大执行时长
XHS_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
XHS_FEED_ENABLE=switch,"true","false",tag=信息流净化，desc=去除首页推荐广告
XHS_SEARCH_ENABLE=switch,"true","false",tag=搜索净化，desc=去除搜索推广词条
XHS_WATERMARK_ENABLE=switch,"true","false",tag=去水印，desc=去除图片/视频水印
XHS_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/home-api\.xiaohongshu\.com\/splash\/config url reject-200, enable={ENABLE_XHS}&{XHS_SPLASH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/splash_config url reject-200, enable={ENABLE_XHS}&{XHS_SPLASH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/system_service\/ads url reject-200, enable={ENABLE_XHS}&{XHS_SPLASH_ENABLE}

# ── 信息流净化模块 ────────────────────
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/homefeed stream-filter, enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/note\/feed stream-filter, enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/user\/posted stream-filter, enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/discovery\/recommend stream-filter, enable={ENABLE_XHS}&{XHS_FEED_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/page\/notes stream-filter, enable={ENABLE_XHS}&{XHS_FEED_ENABLE}

# ── 搜索净化模块 ──────────────────────
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/notes hot-filter, enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/recommend hot-filter, enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/trending hot-filter, enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/search\/hot_list hot-filter, enable={ENABLE_XHS}&{XHS_SEARCH_ENABLE}

# ── 去水印模块 ────────────────────────
http-response ^https?:\/\/sns-img-bd\.xhscdn\.com\/.*\.jpg watermark-remove, enable={ENABLE_XHS}&{XHS_WATERMARK_ENABLE}
http-response ^https?:\/\/sns-video-bd\.xhscdn\.com\/.*\.mp4 watermark-remove, enable={ENABLE_XHS}&{XHS_WATERMARK_ENABLE}
http-response ^https?:\/\/ci\.xiaohongshu\.com\/.*\.(jpg|png|mp4) watermark-remove, enable={ENABLE_XHS}&{XHS_WATERMARK_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/home stream-filter, enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/feed stream-filter, enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/note stream-filter, enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/profile stream-filter, enable={ENABLE_XHS}
http-response ^https?:\/\/api\.xiaohongshu\.com\/api\/sns\/v\d\/ads\/search stream-filter, enable={ENABLE_XHS}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════
cron {XHS_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/XiaoHongShu.js, timeout={TIMEOUT}, tag=小红书定时任务，argument=[{XHS_DEBUG_ENABLE}], enable={ENABLE_XHS}

[Rewrite]
# ── 白名单配置 ────────────────────────
DOMAIN-SUFFIX, xiaohongshu.com, DIRECT
DOMAIN-SUFFIX, xhscdn.com, DIRECT

# ── 特殊域名重定向 ──────────────────
^https?:\/\/xhslink\.com\/\?.* url 302 https://$4, enable={ENABLE_XHS}

[MitM]
hostname = %APPEND% api.xiaohongshu.com, home-api.xiaohongshu.com, sns-img-bd.xhscdn.com, sns-video-bd.xhscdn.com, ci.xiaohongshu.com
