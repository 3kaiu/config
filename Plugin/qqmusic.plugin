#!name=QQ音乐去广告
#!desc=QQ音乐 — 广告域名/追踪/埋点 DNS 级 REJECT (整合 kelee 规则)
#!version=8.8
#!author=3kaiu (规则来源: 可莉🅥)
#!homepage=https://github.com/3kaiu/config
#!icon=https://icons.duckduckgo.com/ip3/qqmusic.ico
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

[Argument]
QQMUSIC_ENABLE=switch,"true","false",tag=是否开启QQ音乐去广告,desc=开启后REJECT所有QQ音乐广告和追踪域名

[Rule]
# 广告 + 追踪域名
# (2026-09-22 删 17 条主配置已无条件 REJECT 的重复, 开关拨动对它们本就无效;
# 登记见 test/cases/plugin-tpl-shadow.test.js; 剩余 3 条为本插件独占拦截)
DOMAIN, mc.tencentmusic.com, REJECT,enable={QQMUSIC_ENABLE}
DOMAIN, tmeadbak.y.qq.com, REJECT,enable={QQMUSIC_ENABLE}
DOMAIN, tmeadquic.y.qq.com, REJECT,enable={QQMUSIC_ENABLE}

# ⚠️ 修复(v7.3): tangram.e.qq.com 已由 qidian.plugin 统一 REJECT, 避免重复

# 纯 DNS 级 REJECT，无需 MitM
[MitM]
# 无 MitM 域名 — QQ音乐去广告全部走 DNS REJECT