#!name=阿里云 ARMS/SLS 上报拦截
#!desc=阿里云 ARMS 用户体验监控(前端 RUM)与 SLS 日志上报通道拦截。纯遥测, 拦了不破功能。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = 隐私,探针,上报,arms,阿里云
#!type = normal
# 本插件**无 [Argument]**: 官方《插件》策略位仅 DIRECT/REJECT/PROXY, 插件参数只作用于
# Script(enable={}) 与 Rewrite(${}); 普通 [Rule] 行挂不了条件 ⇒ 声明即死参数。启停插件即开关。

[Rule]
# ── 生效层: L2 域名 REJECT (DNS 阶段) ────────────────────────────────
# 本仓 domain-reject-mode = DNS ⇒ 拒绝在 DNS 阶段回环完成, 请求到不了解密层。
# 故本插件**无 [MitM]**, 零 CA 证书成本。
#
# 处置口径: 只拦 ARMS 前端监控上报端点。**不拦 arms.console.aliyun.com** —— 那是开发者
# 自己在浏览器里看的控制台, 不是 App 遥测出口, 拦了影响排障。也不拦其它 aliyuncs/oss
# 域 —— OSS 可能承载内容图床。
# 取证: arms-retcode.aliyuncs.com DoH 双解析器 CF=25 条 A 记录 / HTTPS 405(端点存在,
# 拒绝 GET 是正常接口行为); oa-panther.data.aliyun.com 与 log.aliyuncs.com 实测已死
# (CF 解析 0 条), 不加。
# 代价: 丢失 ARMS 链路与前端 RUM 数据, 排障能力下降。
DOMAIN, arms-retcode.aliyuncs.com, REJECT
