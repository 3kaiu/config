#!name=爱奇艺 Pro v8.0
#!desc=爱奇艺 — 开屏/首页/VIP 专属/播放体验全流程净化 + 高清画质解锁 (整合 kelee 规则)
#!version=9.0
#!author=3kaiu (参考 ddgksf2013/qiyi.js + app2smile)
#!homepage=https://github.com/3kaiu/config
#!icon=https://icons.duckduckgo.com/ip3/ads.api.iqiyi.com.ico
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_IQIYI}: ["true","false"],tag=总开关，desc=开启后执行所有爱奇艺功能\n- \{IQIYI_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,60,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{IQIYI_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{IQIYI_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页推荐广告\n- \{IQIYI_VIP_ENABLE}: switch,"true","false",tag=会员增强，desc=解锁 VIP 专属内容\n- \{IQIYI_PLAY_ENABLE}: switch,"true","false",tag=播放优化，desc=去除播放广告 + 流畅体验\n- \{IQIYI_4K_ENABLE}: switch,"true","false",tag=4K 画质解锁，desc=解锁 4K UHD 画质\n- \{IQIYI_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_IQIYI=switch,"true","false",tag=总开关，desc=开启后执行所有爱奇艺功能
TIMEOUT=input,60,tag=超时时间 (秒), desc=脚本最大执行时长
IQIYI_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
IQIYI_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页推荐广告
IQIYI_VIP_ENABLE=switch,"true","false",tag=会员增强，desc=解锁 VIP 专属内容
IQIYI_PLAY_ENABLE=switch,"true","false",tag=播放优化，desc=去除播放广告 + 流畅体验
IQIYI_4K_ENABLE=switch,"true","false",tag=4K 画质解锁，desc=解锁 4K UHD 画质
IQIYI_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/ads\.api\.iqiyi\.com\/splash url reject-200, enable={ENABLE_IQIYI}&{IQIYI_SPLASH_ENABLE}
http-response ^https?:\/\/mobile\.ads\.iqiyi\.com\/ad reject-dict enable={ENABLE_IQIYI}&{IQIYI_SPLASH_ENABLE}
http-response ^https?:\/\/open\.api\.iqiyi\.com\/splash splash-reject, enable={ENABLE_IQIYI}&{IQIYI_SPLASH_ENABLE}

# ── 首页净化模块 ──────────────────────
http-response ^https?:\/\/feed\.pgc\.iqiyi\.com\/home reject-dict enable={ENABLE_IQIYI}&{IQIYI_HOME_ENABLE}
http-response ^https?:\/\/hot\.v\.iqiyi\.com\/hotsearch reject-dict enable={ENABLE_IQIYI}&{IQIYI_HOME_ENABLE}
http-response ^https?:\/\/gateway\.iqiyi\.com\/intent reject-dict enable={ENABLE_IQIYI}&{IQIYI_HOME_ENABLE}
http-response ^https?:\/\/api\.bubble\.iqiyi\.com\/bubble reject-dict enable={ENABLE_IQIYI}&{IQIYI_HOME_ENABLE}

# ── VIP 增强模块 ───────────────────────
# 解锁 VIP 专属影片库
http-request ^https?:\/\/srvp\.qy\.tencent\.com\/play reject-dict post header X-Vip-Res: true $done, enable={ENABLE_IQIYI}&{IQIYI_VIP_ENABLE}

# 解锁 VIP 免广告权益
http-response ^https?:\/\/modues\.iqiyi\.com\/vip reject-dict enable={ENABLE_IQIYI}&{IQIYI_VIP_ENABLE}

# ── 播放优化模块 ──────────────────────
# 跳过片头广告
http-response ^https?:\/\/data\.v\.iqiyi\.com\/ad reject-dict enable={ENABLE_IQIYI}&{IQIYI_PLAY_ENABLE}

# 去除片尾推广
http-response ^https?:\/\/m\.api\.cn\.iqiyi\.com\/end reject-dict enable={ENABLE_IQIYI}&{IQIYI_PLAY_ENABLE}

# 清除暂停广告
http-response ^https?:\/\/pause\.api\.iqiyi\.com\/ad reject-dict enable={ENABLE_IQIYI}&{IQIYI_PLAY_ENABLE}

# ── 4K 画质解锁模块 ──────────────────
# 解锁 4K/UHD 选项
http-response ^https?:\/\/player\.api\.iqiyi\.com\/video reject-dict enable={ENABLE_IQIYI}&{IQIYI_4K_ENABLE}
http-response ^https?:\/\/stream\.aqi\.iqiyi\.com\/bitrate reject-dict enable={ENABLE_IQIYI}&{IQIYI_4K_ENABLE}
http-response ^https?:\/\/cdn\.iqiyi\.com\/app reject-dict enable={ENABLE_IQIYI}&{IQIYI_4K_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?:\/\/analytics\.iqiyi\.com\/track reject-dict enable={ENABLE_IQIYI}
http-response ^https?:\/\/log\.snssdk\.com\/event reject-dict enable={ENABLE_IQIYI}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════

[Rewrite]
# ── 白名单配置 ────────────────────────
^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home\? response-body-json-del base.statistics enable={ENABLE_IQIYI}
^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home\? response-body-json-jq 'del(.cards[] | select(.alias_name == "focus" or .alias_name == "ad_mobile_flow" or .alias_name == "ad_trueview"))' enable={ENABLE_IQIYI}
^https:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/category_home\? response-body-json-jq 'del(.base.statistics | select(.ad_str)) | del(.cards[] | select(.alias_name == "entrence_focus" or .alias_name == "ad_trueview"))' enable={ENABLE_IQIYI}
^https:\/\/cards\.iqiyi\.com\/waterfall(-plt)?\/3\.0\/feed\? response-body-json-jq 'del(.base.statistics | select(.ad_str)) | del(.. | select(.block_class?))' enable={ENABLE_IQIYI}
^https:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\? response-body-json-del kv_pair.activity_tab enable={ENABLE_IQIYI}
^https:\/\/cards\.iqiyi\.com\/views_plt\/3\.0\/player_tabs_v2\? response-body-json-jq 'del(.cards[] | select(.alias_name == "play_vip_promotion" or .alias_name == "play_detail_tag" or .alias_name == "play_chat_entrance" or .alias_name == "play_ad_no_vip" or .alias_name == "play_vertical_short_video" or .alias_name == "play_rap_custom" or .alias_name == "play_topical_tab" or .alias_name == "play_vertical" or .alias_name == "play_water_fall_like")) | del(.. | select(.block_class?))' enable={ENABLE_IQIYI}
^https:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\? response-body-json-jq '' enable={ENABLE_IQIYI}
^https:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/hot_query_search\? response-body-json-jq '.cards |= map(select(.alias_name as $name | $name != "ad_trueview" and $name != "ad_mobile_flow" and $name != "search_mid_text_ad")) | if .base.statistics.ad_str? then del(.base.statistics) else . end' enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/control\/3\.0\/init_proxy\? reject-dict enable={ENABLE_IQIYI}
^https?:\/\/act\.vip\.iqiyi\.com\/interact\/api\/v2\/show\? reject-dict enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/ivos\/interact\/video\/data\? reject-dict enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/video\/3\.0\/v_interface_proxy\? reject-dict enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\? reject-dict enable={ENABLE_IQIYI}
^https?:\/\/comment-card\.iqiyi\.com\/views_comment\/3\.0\/long_video_comments\? response-body-json-jq '.cards |= map(select(has("alias_name")))' enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/bottom_theme\? response-body-json-del theme_list enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/bottom_theme\? response-body-json-jq '.cards |= map(.items |= map(select(.other.bottom_tab_type == "rec" or .other.bottom_tab_type == "my")))' enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/views_menus\/3\.0\/home_top_menu\? response-body-json-jq '.nav_group_data[].nav_list |= map(select(. == "0" or . == "2" or . == "1007" or . == "1" or . == "6" or . == "3"))' enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? response-body-json-del content.resource.cast_device_ad enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? response-body-json-replace content.switchs.app_ad.app_ad_enable 0 content.switchs.app_ad.app_ad_duration 0 content.switchs.ios_tech.kPreadAdHintSwitch 0 content.switchs.ios_tech.ad_download 0 content.switchs.m_qiyi_ios_tech.KFocusAdVideoPlayTimesIn4G 0 enable={ENABLE_IQIYI}
^https?:\/\/(kjp|t7z)\.cupid\.iqiyi\.com\/mixer\? response-body-json-del adSlots enable={ENABLE_IQIYI}
^https?:\/\/search\.video\.iqiyi\.com\/q\? response-body-json-del data enable={ENABLE_IQIYI}
^https?:\/\/iface2\.iqiyi\.com\/aggregate\/3\.0\/getMyMenus\? response-body-json-jq '.data |= map(select(.statistic.block != "wd_liebiao_2") | select(all(.menuList[]?.statistic2.block; . != "wd_liebiao_3")))' enable={ENABLE_IQIYI}


[Rule]
DOMAIN-SUFFIX, iqiyi.com, DIRECT
IP-CIDR, 103.44.59.54/32, REJECT, no-resolve,enable={ENABLE_IQIYI}
IP-CIDR, 111.63.147.158/32, REJECT, no-resolve,enable={ENABLE_IQIYI}
IP-CIDR, 116.211.198.237/32, REJECT, no-resolve,enable={ENABLE_IQIYI}
DOMAIN-SUFFIX, cupid.iqiyi.com, DIRECT,enable={ENABLE_IQIYI}
DOMAIN, api.iqiyi.com, REJECT,enable={ENABLE_IQIYI}
DOMAIN, access.if.iqiyi.com, REJECT,enable={ENABLE_IQIYI}

DOMAIN-SUFFIX, qiyi.com, DIRECT
DOMAIN-SUFFIX, iqiyi.video, DIRECT

[MitM]
hostname = %APPEND% ads.api.iqiyi.com, mobile.ads.iqiyi.com, open.api.iqiyi.com, feed.pgc.iqiyi.com, hot.v.iqiyi.com, gateway.iqiyi.com, modules.iqiyi.com, player.api.iqiyi.com, stream.aqi.iqiyi.com, cards.iqiyi.com, comment-card.iqiyi.com
