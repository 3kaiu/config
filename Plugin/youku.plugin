#!name=优酷去广告
#!desc=优酷 - 开屏/广告追踪/视频广告净化
#!version=7.8
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Youku.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

[Argument]
YOUKU_ENABLE=switch,"true","false",tag=是否开启优酷去广告,desc=开启后净化优酷开屏/追踪/视频广告

[Script]
# 开屏广告 - 清空广告数组
http-response ^https?:\/\/api\.youku\.com script-path=https://ws.wenn.in/main/Scripts/Youku.js, requires-body=true, timeout=10, tag=优酷开屏净化, enable={YOUKU_ENABLE}
# 广告追踪 - 移除 banner/promo
http-response ^https?:\/\/iyes\.youku\.com script-path=https://ws.wenn.in/main/Scripts/Youku.js, requires-body=true, timeout=10, tag=优酷广告追踪, enable={YOUKU_ENABLE}
# 视频广告 - 清空广告数组
http-response ^https?:\/\/vali\.cp31\.ott\.cibntv\.net script-path=https://ws.wenn.in/main/Scripts/Youku.js, requires-body=true, timeout=10, tag=优酷视频广告, enable={YOUKU_ENABLE}

[MitM]
hostname = %APPEND% api.youku.com, iyes.youku.com, vali.cp31.ott.cibntv.net
