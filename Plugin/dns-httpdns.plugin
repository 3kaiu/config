#!name=HTTPDNS 拦截器（应用内解析收编）
#!desc=拦截常见 App SDK 的 HTTPDNS 服务端点, 让应用内解析回落到系统 DNS ⇒ 进入 Loon 的 DNS 框架。所有去广告插件的依赖之一。
#!author=3kaiu
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag = DNS,HTTPDNS,去广告依赖
#!type = normal
# ── L0 依赖层契约 (2026-09-30 架构分层) ────────────────────────────────
# 本插件与 `ad-block.plugin`(广告平台拦截器) / `dns-leak.plugin`(DNS 防泄漏) 同属 **L0 依赖层**:
#   · 只放"所有去广告插件都需要"的域集, 不放任何单 App 的广告位逻辑;
#   · 必须排在 `[Plugin]` 段**最前** —— 否则后置插件的 DIRECT/Proxy 对同域会先命中
#     (官方《规则》页: 规则来源优先级 = 本地 > 插件 > 订阅, 插件之间按登记顺序);
#   · 用户仍需安装其他去广告插件(单 App 广告位净化在 jd.plugin / qidian.plugin 等)。
# 顺序与依赖由 test/cases/plugin-layering.test.js 钉死, 不靠注释自觉。
# 无 [Argument]/[Script]/[Rewrite]/[MitM]: `[Rule]` 行挂不了条件参数(声明即死参数);
#   纯 L2 域名 REJECT 零证书成本(本仓 domain-reject-mode = DNS + dns-reject-mode = LOOPBACKIP,
#   拒绝在 DNS 阶段用回环地址完成, 请求到不了 HTTP 响应层)。
#
# ── 为什么必须拦 (官方依据 + 缺口分析) ─────────────────────────────────
# 官方《通用配置》: `hijack-dns` 只收编**明文 UDP DNS**。而自带 HTTPDNS 的 App SDK 用
# HTTP(S) API 直接取 IP, 完全绕过系统 DNS ⇒ 广告/追踪域拿到**真实 IP** ⇒ DNS 阶段的域名
# REJECT 整体失效 ⇒ 请求落到 IP 规则上被 GEOIP,CN,DIRECT 直连放行。
# 拦掉 HTTPDNS 端点后, SDK 只能回落系统 DNS ⇒ 进入 Loon 的 hijack-dns + doh-server 链,
# 拒绝面恢复。这一层是所有去广告插件生效的**前置条件**, 故与广告平台拦截器同列 L0。
#
# ── 取证 (2026-09-30: 双解析器 @223.5.5.5 AliDNS + @119.29.29.29 DNSPod, A 记录 + 端口探针) ──
# 逐条登记(括号内为双解析器实测 A 记录; "一致" = 两解析器返回同一集合):
#   httpdns-api.aliyuncs.com  106.11.232.13                       (一致)
#   httpdns.aliyun.com        112.87.86.2/112.87.86.3/139.227.225.151/139.227.225.152 (一致)
#   httpdns.qq.com            182.254.116.120                     (一致)
#   httpdns.baidu.com         110.242.69.16                       (一致)
#   httpdns.baidubce.com      103.211.221.200                     (一致)
#   httpdns.volces.com        多 A 集合(双解析器均 NOERROR, 按机房不同)
#   httpdns.bytedance.com     多 A 集合(同上)
#   httpdns.umengcloud.com    110.75.96.12                        (一致)
#   httpdns.jd.com            111.206.227.147/120.52.148.28       (一致)
#   httpdns.meituan.com       101.236.69.43/103.37.152.92         (一致)
#   httpdns.taobao.com        59.82.29.204 | 203.119.169.240      (解析器视角不同, 均 NOERROR)
# **全部 11 条 443 与 80 端口均无站点响应**(curl 连接失败, 非 4xx/5xx) ⇒ 典型的"只有 SDK 的
# HTTP API 会连"的端点, 不存在功能页, 拦截不产生功能损失 —— 这正是本仓"可拦"判据。
# 已剔除(NXDOMAIN, 不许凭名字写规则): httpdns.dnspod.com / httpdns.umeng.com / httpdns.miui.com /
#   httpdns.huawei.com / httpdns.iqiyi.com / httpdns.dnsv1.com / httpdns.kuaishou.com /
#   httpdns.duxiaoman.com; httpdns.ksyun.com = NOERROR 但 0 条 A, 同样不写。
# **绝不拦(本仓解析链)**: `dns.alidns.com` / `doh.pub` —— 见 dns-leak.plugin 同名排除段。
#
# ── 兜底策略 ──────────────────────────────────────────────────────────
# 上面 11 条是**可枚举**的已知厂商端点(本仓纪律: 可枚举即不用宽匹配, 官方《规则》页亦记
# DOMAIN-KEYWORD 耗时随数量线性恶化)。未收录的新厂商靠末尾两条**锚定**关键词规则兜住 ——
# 插件内裸 DOMAIN-KEYWORD 被 tools/plugin-lint-check.mjs 判红, 必须 AND 锚定(与
# qidian.plugin 的 AND 样板同形)。锚定限制: 只覆盖 .com/.cn, 其他 TLD 的 httpdns 主机不在兜底内。
[Rule]
#
# ══ HTTPDNS 服务端点 (逐条取证, 见上方登记) ══
DOMAIN, httpdns-api.aliyuncs.com, REJECT
DOMAIN, httpdns.aliyun.com, REJECT
DOMAIN, httpdns.qq.com, REJECT
DOMAIN, httpdns.baidu.com, REJECT
DOMAIN, httpdns.baidubce.com, REJECT
DOMAIN, httpdns.volces.com, REJECT
DOMAIN, httpdns.bytedance.com, REJECT
DOMAIN, httpdns.umengcloud.com, REJECT
DOMAIN, httpdns.jd.com, REJECT
DOMAIN, httpdns.meituan.com, REJECT
DOMAIN, httpdns.taobao.com, REJECT

# ── 厂商私有 DNS / HTTPDNS 端点 (2026-09-30 扩面) ──────────────────────────
