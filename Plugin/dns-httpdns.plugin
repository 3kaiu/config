#
# ── 三种新技法(同源吸纳, 各带独立判据) ─────────────────────────────────
# ① SDK 的 UA 面: HTTPDNS SDK 走**明文 HTTP** 时带 httpdns*/httpsdns* 的 UA; 明文请求头可见
#    ⇒ **无需 MitM**, 本插件仍零解密面。四种大小写是实测变体。
USER-AGENT, "httpdns*", REJECT
USER-AGENT, "httpsdns*", REJECT
USER-AGENT, "Httpdns*", REJECT
USER-AGENT, "Httpsdns*", REJECT
# ② IP 形态的明文 HTTPDNS: 域名规则够不着裸 IP 请求(本仓此前列为残留面), 而这类请求路径形状
#    固定(/d? /d4? /ss6? /resolve?)。只匹配 **http://** —— 加 https 就要 MitM, 与零解密面冲突
#    (plugin-layering 用例断言 dns-* 的 URL-REGEX 必须是明文)。行尾 \? 是字面问号, 故 /download 不误命中。
URL-REGEX, "^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?", REJECT
URL-REGEX, "^http:\/\/\[[0-9a-fA-F:]+\](?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?", REJECT
# ③ 上述 IP 形态会误伤正常用 HTTPDNS 的出行类 App ⇒ 两条定向放行(同源): 嘀嗒出行(UA 为中文的
#    URL 编码)走 119.29.29.90 / 119.28.28.90 的 /d? 保持直连。carve-out 是社区踩出来的;
#    我们照搬形态但留复核记录, 便于社区 UA 变更时定位。
AND, ((URL-REGEX, ^http:\/\/119\.29\.29\.90\/d\?), (USER-AGENT, %E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)), DIRECT
AND, ((URL-REGEX, ^http:\/\/119\.28\.28\.90\/d\?), (USER-AGENT, %E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)), DIRECT
#
# ── 已评估**未采纳**(附理由, 免得后人再抄一遍) ─────────────────────────
# · 裸 DOMAIN-KEYWORD httpdns/httpsdns: 本仓 plugin-lint-check 判红(插件内裸关键词禁止; 官方记
#   其耗时随数量线性增长), 且已有 AND 锚定兜底 + 上述 60 条枚举, 覆盖等价。
# · 67 条 IP-CIDR …/32: 逐 IP 钉死有共享 IP 误伤风险(同 IP 可能兼作他服务); 技法② 已用路径
#   形态覆盖明文 IP HTTPDNS —— 不钉 IP 也能拦。厂商专属段(如 203.107.1.0/24)可另行裁决。
# · 4 条实测无 A(死规则): dns.iqiyi.com / dns.qiyipic.iqiyi.com / httpdns.bilivideo.com /
#   httpdns-v6.gslb.yy.com。
# · 2 条 200+HTML(转人工): cdndns.kwd.inkuai.com / dns.weibo.cn —— 疑站点页, 按「有功能页不拦」不收。
# · amdc.alipay.com: 支付宝**服务下发面**(302+html); 与 M4 银行/支付免解密免广告姿态冲突, 可能影响
#   支付链路 ⇒ 未收录; 若要动须按 APP-ONBOARDING 单独取证。

#
# ══ 未收录厂商的锚定兜底 (AND + DOMAIN-SUFFIX, 同 qidian 样板) ══
AND,((DOMAIN-KEYWORD,httpdns),(DOMAIN-SUFFIX,com)),REJECT
AND,((DOMAIN-KEYWORD,httpdns),(DOMAIN-SUFFIX,cn)),REJECT

