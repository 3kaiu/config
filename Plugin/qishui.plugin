#!name=汽水音乐去广告
#!desc=汽水音乐 — 视频/信息流/搜索推广/热门搜索/会员推广净化 (v7.6: qishui.js 上游已删除, 改用纯 Rewrite reject)
#!version=7.8
#!author=3kaiu (规则来源: ddgksf2013)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Qishui.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

[Argument]
QISHUI_ENABLE=switch,"true","false",tag=是否开启汽水音乐去广告,desc=开启后通过 URL 拒绝规则净化汽水音乐

[Rewrite]
# ── 视频广告 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/media_ads/i then reject(200)
# ── 通用广告 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/ads/i then reject(200)
# ── 位置隐私 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/location\/info/i then reject(200)
# ── 广告弹窗 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/commerce/i then reject(200)
# ── TAGS推荐 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/hashtag\/recommend/i then reject(200)
# ── 热门搜索 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/search-block/i then reject(200)
# ── DNS 处理 ──
request if ${url} ~= /^https:\/\/tnc[\w-]*\.zijieapi\.com\/get_domains/i then reject(200)
# ── 我的页面推广 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/me\?/i then reject_dict(200)
# ── 会员免费听 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/card(\?|$)/i then reject_dict(200)
# ── 首页活动 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/activities(\?|$)/i then reject_dict(200)
# ── 音乐流推荐 ──
request if ${url} ~= /^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/feed\/song-tab(\?|$)/i then reject_dict(200)

[MitM]
hostname = %APPEND% beta-luna.douyin.com, api.qishui.com, tnc-alisg.zijieapi.com, tnc-zijieapi.zijieapi.com