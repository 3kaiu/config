#!name=墨鱼去开屏广告 Pro v2.0
#!desc=覆盖数百个 App 的开屏广告通杀过滤 · 基于 ddgksf2013 的 StartUp.conf + AllInOne 综合净化
#!version=2.0
#!author=3kaiu (参考 ddgksf2013 + blackmatrix7)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

#!arguments-desc=\n- \{ENABLE_STARTUP}: ["true","false"],tag=总开关，desc=开启后过滤所有 App 开屏广告\n- \{STARTUP_DEBUG}: switch,"false","true",tag=调试模式，desc=输出详细日志

[Argument]
ENABLE_STARTUP=switch,"true","false",tag=总开关，desc=开启后过滤所有 App 开屏广告
STARTUP_DEBUG=switch,"false","true",tag=调试模式，desc=输出详细日志

[Script]
# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选）
# ════════════════════════════════════════

[Rewrite]
# ── 🎬 开屏广告通杀层 (ddgksf2013 风格) ────────────────────

# ════════════════════════════════════════
# ① 视频/直播类 App
# ══════════════
request if ${url} ~= /^https?:\/\/ads\.api\.(yy|6rooms)\.com\/.*\/splash/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/mcs\.mm\.(cc|tv)\.cn\/splash\/getSplashAd/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/live-bd\.biliapi\.net\/open\/app\/splash\/v2\/detail/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/app-api\.huya\.com\/splash\/load/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/splash\.snssdk\.com\/splash\/widget\/list/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ② 电商购物类 App  
# ═══════════════════
request if ${url} ~= /^https?:\/\/ad\.taobao\.com\/serv\/KP_SplashAD\.json/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/ad\.m\.taobao\.com\/feed\/splash\/list\.json/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/pinduo\.du\.ru\/index\.php\/mobile\/Splash\//i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/splash\.jd\.com\/static\/splash\/\//i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/ads\.api\.meituan\.com\/splashurl\/list/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/ads\.suning\.com\/splash\/getSplashAd/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ③ 社交/通讯类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/flash\.qq\.com\/splash\/list\.json/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/api\.wan\..*\.weixin\.qq\.com\/cgi-bin\/ad\/launch/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/api\.mqq\.com\/splash\/control/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ④ 资讯阅读类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/ads\.sina\.com\.cn\/app\/api\/splash\/info/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/api\.zhuishushenqi\.com\/splashes\/ios/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/api\.zcool\.com\.cn\/common\/open-screen/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/app3\.qdaily\.com\/app3\/boot_advertisements\.json/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/tos-cn\/i-4r7-eur\/splash/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ⑤ 工具效率类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/ads\.api\.wps\.cn\/web\/splash/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/flash\.iciba\.com\/open\/screens/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/service\.iciba\.com\/popo\/open\/screens\/v\d\?adjson/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/flashscreen\.duokan\.com\/getFlashScreenPage/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ⑥ 音乐/音频类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/god\.gameyw\.netease\.com\/v\d\/ad\/serving\/app-start/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/music\.interface\.163\.com\/api\/splash\/get/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ⑦ 出行/旅游类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/flightcheckin\.ctrip\.com\/splash\/splashUrl/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/apigw\.fliggy\.com\/splash\/list/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/api\.gaode\.com\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/busi\.kuaidi100\.com\/splash\/getSplashAd/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ⑧ 教育/学习类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/splash\.yuanfudao\.com\/splash\/list/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/ad\.class\.tiktokv\.com\/splash\/info/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/splash\.xueersi\.com\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ⑨ 金融银行类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/creditcardapp\.bankcomm\.cn\/mappweb_interface\/common\/qryLaunchAds\.do/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/m\.ccb\.com\/splash\/getSplashAd/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/app\.abc\.china.cn\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/app\.cmbchina\.com\/splash\/get/i && ${ENABLE_STARTUP} == true then reject(200)

# ════════════════════════════════════════
# ⑩ 地图导航类 App
# ════════════════════
request if ${url} ~= /^https?:\/\/api\.amap\.com\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/lbs\.yunli\.com\.cn\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)
request if ${url} ~= /^https?:\/\/map\\.baidu\.com\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)

# ── 特殊应用补充 ───────────────────────
# 小红书
request if ${url} ~= /^https?:\/\/home-api\.xiaohongshu\.com\/splash\/config/i && ${ENABLE_STARTUP} == true then reject(200)
# 抖音/TikTok
request if ${url} ~= /^https?:\/\/push\.snssdk\.com\/splash\/log/i && ${ENABLE_STARTUP} == true then reject(200)
# 快手
request if ${url} ~= /^https?:\/\/splash\.kuaishou\.com\/splash\/list/i && ${ENABLE_STARTUP} == true then reject(200)
# 哔哩哔哩漫画
request if ${url} ~= /^https?:\/\/acmt\.bilifast\.net\/splash\/load/i && ${ENABLE_STARTUP} == true then reject(200)
# 微博国际版
request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/2\/splash/i && ${ENABLE_STARTUP} == true then reject(200)

[MitM]
# ⚠️ 注意：部分 App 禁用了 MITM，无法拦截其开屏广告
hostname = %APPEND% splash.*, ad.*, flash.*
