#!name=淘票票去广告 Pro v7.8
#!desc=淘票票 — 开屏/首页/搜索/影院全流程净化 + 功能模块控制
#!version=7.8
#!author=3kaiu (基于通用插件增强框架)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TaoPiao.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

#!arguments-desc=\n- \{ENABLE_TAOPIAOPIAO}: ["true","false"],tag=总开关，desc=开启后执行所有淘票票功能\n- \{TAOPIAOPIAO_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,60,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{TAOPIAOPIAO_SCRINSCEEN_ENABLE}: switch,"true","false",tag=开屏广告，desc=拦截开屏广告\n- \{TAOPIAOPIAO_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页信息流推广\n- \{TAOPIAOPIAO_SEARCH_ENABLE}: switch,"true","false",tag=搜索净化，desc=去除搜索结果推广\n- \{TAOPIAOPIAO_MINE_ENABLE}: switch,"true","false",tag=我的页面，desc=去除个人中心推广\n- \{TAOPIAOPIAO_POPUP_ENABLE}: switch,"true","false",tag=弹窗广告，desc=拦截启动弹窗\n- \{TAOPIAOPIAO_CINEMA_ENABLE}: switch,"true","false",tag=影院广告，desc=去除影院 Tab 栏广告\n- \{TAOPIAOPIAO_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_TAOPIAOPIAO=switch,"true","false",tag=总开关，desc=开启后执行所有淘票票功能
TIMEOUT=input,60,tag=超时时间 (秒), desc=脚本最大执行时长
TAOPIAOPIAO_SCRINSCEEN_ENABLE=switch,"true","false",tag=开屏广告，desc=拦截开屏广告
TAOPIAOPIAO_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页信息流推广
TAOPIAOPIAO_SEARCH_ENABLE=switch,"true","false",tag=搜索净化，desc=去除搜索结果推广
TAOPIAOPIAO_MINE_ENABLE=switch,"true","false",tag=我的页面，desc=去除个人中心推广
TAOPIAOPIAO_POPUP_ENABLE=switch,"true","false",tag=弹窗广告，desc=拦截启动弹窗
TAOPIAOPIAO_CINEMA_ENABLE=switch,"true","false",tag=影院广告，desc=去除影院 Tab 栏广告
TAOPIAOPIAO_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ═══════════════════════════════════════════
# 🔄 AMDC 净化（响应阶段）
# ═══════════════════════════════════════════
http-response ^http:\/\/amdc\.m\.taobao\.com script-path=https://ws.wenn.in/main/Mirror/amdc.js, requires-body=true, timeout=10, tag=AMDC 净化，enable={ENABLE_TAOPIAOPIAO}

# ═══════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ═══════════════════════════════════════════

[Rewrite]
# ── 开屏广告模块 ─────────────────────
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryloadingbanner/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_SCRINSCEEN_ENABLE} == true then reject(200)

# ── 首页净化模块 ─────────────────────
# 广告预加载
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.independentadvertiseapi\.querypreloadadvertise/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_HOME_ENABLE} == true then reject(200)

# 首页信息流顶部和最底部
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.aristotle\.get/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_HOME_ENABLE} == true then reject(200)

# ── 搜索净化模块 ────────────────────
# 搜索框下方推广
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopsearchapi\.getranklistbytypeforsearch/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_SEARCH_ENABLE} == true then reject(200)

# 搜索填词推广
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopintegrationapi\.homeconfig/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_SEARCH_ENABLE} == true then reject(200)

# ── 我的页面模块 ────────────────────
# 我的页面推广 Banner
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopindependentadvertiseapi\.queryadvertise/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_MINE_ENABLE} == true then reject(200)

# ── 弹窗广告模块 ────────────────────
# 启动弹窗
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.popup\.get/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_POPUP_ENABLE} == true then reject(200)

# ── 影院广告模块 ────────────────────
# 影院 Tab 栏顶部广告
request if ${url} ~= /^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopitemadvertiseapi\.queryadvertise/i && ${ENABLE_TAOPIAOPIAO} == true && ${TAOPIAOPIAO_CINEMA_ENABLE} == true then reject(200)

[MitM]
hostname = %APPEND% acs.m.taobao.com, amdc.m.taobao.com
