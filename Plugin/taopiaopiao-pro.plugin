#!name=淘票票去广告 Pro v7.8
#!desc=淘票票 — 开屏/首页/搜索/影院全流程净化 + 功能模块控制
#!version=7.8
#!author=3kaiu (基于通用插件增强框架)
#!homepage=https://github.com/3kaiu/config
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)

#!arguments-desc=\n- \{ENABLE_TAOPIAOPIAO}: switch,"true","false",tag=总开关，desc=开启后执行所有淘票票功能\n- \{TAOPIAOPIAO_SCRINSCEEN_ENABLE}: switch,"true","false",tag=开屏广告，desc=拦截开屏广告\n- \{TAOPIAOPIAO_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页信息流推广\n- \{TAOPIAOPIAO_SEARCH_ENABLE}: switch,"true","false",tag=搜索净化，desc=去除搜索结果推广\n- \{TAOPIAOPIAO_MINE_ENABLE}: switch,"true","false",tag=我的页面，desc=去除个人中心推广\n- \{TAOPIAOPIAO_POPUP_ENABLE}: switch,"true","false",tag=弹窗广告，desc=拦截启动弹窗\n- \{TAOPIAOPIAO_CINEMA_ENABLE}: switch,"true","false",tag=影院广告，desc=去除影院 Tab 栏广告

[Argument]
ENABLE_TAOPIAOPIAO=switch,"true","false",tag=总开关，desc=开启后执行所有淘票票功能
TAOPIAOPIAO_SCRINSCEEN_ENABLE=switch,"true","false",tag=开屏广告，desc=拦截开屏广告
TAOPIAOPIAO_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页信息流推广
TAOPIAOPIAO_SEARCH_ENABLE=switch,"true","false",tag=搜索净化，desc=去除搜索结果推广
TAOPIAOPIAO_MINE_ENABLE=switch,"true","false",tag=我的页面，desc=去除个人中心推广
TAOPIAOPIAO_POPUP_ENABLE=switch,"true","false",tag=弹窗广告，desc=拦截启动弹窗
TAOPIAOPIAO_CINEMA_ENABLE=switch,"true","false",tag=影院广告，desc=去除影院 Tab 栏广告

#==================================================================
# [Script] 段已移除 (2026-09-29): 原 16/1 条全部直连第三方上游
#   (netease.adblock.js / amdc.js), 按决定「暂时只留自己维护的」整体移除。
#   本插件保留全部 [Rewrite] 本地规则; [MitM] 与之配套的解密面不受影响。
# taopiaopiao-pro 的脚本能力待后续自研脚本补回。
###################################################################
[Rewrite]
# ── 开屏广告模块 ─────────────────────
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryloadingbanner reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_SCRINSCEEN_ENABLE}

# ── 首页净化模块 ─────────────────────
# 广告预加载
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.independentadvertiseapi\.querypreloadadvertise reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_HOME_ENABLE}

# 首页信息流顶部和最底部
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.aristotle\.get reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_HOME_ENABLE}

# ── 搜索净化模块 ────────────────────
# 搜索框下方推广
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopsearchapi\.getranklistbytypeforsearch reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_SEARCH_ENABLE}

# 搜索填词推广
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopintegrationapi\.homeconfig reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_SEARCH_ENABLE}

# ── 我的页面模块 ────────────────────
# 我的页面推广 Banner
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopindependentadvertiseapi\.queryadvertise reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_MINE_ENABLE}

# ── 弹窗广告模块 ────────────────────
# 启动弹窗
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.life\.popup\.get reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_POPUP_ENABLE}

# ── 影院广告模块 ────────────────────
# 影院 Tab 栏顶部广告
^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopitemadvertiseapi\.queryadvertise reject-200 enable={ENABLE_TAOPIAOPIAO}&{TAOPIAOPIAO_CINEMA_ENABLE}

[MitM]
hostname = %APPEND% acs.m.taobao.com, amdc.m.taobao.com
