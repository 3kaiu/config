#!name=影音阅读净化
#!desc=聚合: 酷狗/酷我/优酷/番茄小说 — 单插件统一总开关, 各 App 独立子开关
#!version=1.0
#!author=3kaiu (聚合器生成)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Music.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.2.4(787)
#!tag=🎵 影音阅读净化

[Argument]
BODIANMUSIC_ENABLE=switch,"true","false",tag=是否开启波点音乐净化,desc=波点音乐去广告
KUGOUYOUTH_ENABLE=switch,"true","false",tag=是否开启酷狗概念版净化,desc=酷狗概念版去广告
SPOTIFY_ENABLE=switch,"true","false",tag=是否开启Spotify净化,desc=Spotify去广告
MEDIA_ENABLE=switch,"true","false",tag=总开关,desc=关闭后整组净化全部停用
KUGOU_ENABLE=switch,"true","false",tag=是否开启酷狗音乐去广告,desc=开启后净化开屏/移动/信息流 Banner 广告
KUWO_ENABLE=switch,"true","false",tag=是否开启酷我音乐去广告,desc=开启后净化酷我音乐广告服务响应数据
YOUKU_ENABLE=switch,"true","false",tag=是否开启优酷去广告,desc=开启后净化优酷开屏/追踪/视频广告
FANQIE_ENABLE=switch,"true","false",tag=总开关，desc=开启后执行所有番茄小说净化功能

[Rewrite]
^https:\/\/bd-api\.kuwo\.cn\/api\/(play|service|advert)\/advert\/ reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\? response-body-json-del data.groupSign.adStartAppDialog data.groupSign.adGuideTest data.groupSign.playTips data.groupSign.adExitChange data.conf.adGuidePopCount data.conf.adDownListOpen enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\? response-body-json-replace data.conf.flowControlConfig.uploadEnable false data.conf.flowControlConfig.p2pEnable false enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/ab-bodian\.kuwo\.cn\/abtest\/ui\/info\? response-body-json-del data.mapTestInfo.CommentADPosition data.mapTestInfo.DiscoverADPosition data.mapTestInfo.DownloadAd data.mapTestInfo.FreeModVoiceReminder data.mapTestInfo.GamesTrans data.mapTestInfo.bodianmvdialog data.mapTestInfo.MvTryShowAds data.mapTestInfo.insert enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\? response-body-json-del data.iosP2PCacheEnable data.warmStartDialog data.adsNotFinishVipPop4DayInterval enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\? response-body-json-replace data.showShopEntry false data.iosP2pEnableSendDataLimit 1 enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/banner\/ reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/ucenter\/vip\/give\/config\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list\? response-body-json-del data.hotTopic data.searchFind data.globalJumpInfo data.hotWord enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/index\? response-body-json-jq '.data.moduleList |= map(select(.type | tostring | (. != "8" and . != "1")))' enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/module\?.*&moduleId=6 reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList\? response-body-json-jq '.data.musicList[] |= del(.showAd)' enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/comments\/v3\/topInfo\? response-body-json-del .data.putao data.bannerVos enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/lowPriceText\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/vipEnter\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/popup\/ reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/swell\/popup\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/service\/version\/popup\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/assist\/popup\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/h5\/common\/popup\? reject-dict enable={MEDIA_ENABLE}&{BODIANMUSIC_ENABLE}
^https:\/\/gateway\.kugou\.com\/ads\.service\/ reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/youth\/v1\/start_img\/last\? reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/youth\/v1\/yueku\/tab\? response-body-json-jq '.data.responses |= map(select(.module == "new_song_publish" or .module == "song_rank"))' enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/ads\.gateway\/ reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^http:\/\/mobilelog\.kugou\.com\/adtrackconfig\.json$ reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/youth\/v1\/experiment\/get_params\? reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/youth\/api\/user\/v1\/init\? reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/youth\/v2\/activity\/task_list\? reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/youth\/v1\/channel\/tab_list\? reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/gateway\.kugou\.com\/goddess\/v1\/content\/biz_list\? reject-dict enable={MEDIA_ENABLE}&{KUGOUYOUTH_ENABLE}
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\/ reject-dict enable={MEDIA_ENABLE}&{SPOTIFY_ENABLE}
^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone header https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad enable={MEDIA_ENABLE}&{SPOTIFY_ENABLE}

[Rule]
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT,enable={MEDIA_ENABLE}&{SPOTIFY_ENABLE}

[Script]
http-response ^https?:\/\/ads\.kugou\.com script-path=https://ws.wenn.in/main/Scripts/Kugou.js, requires-body=true, timeout=10, tag=酷狗_广告投放, enable={MEDIA_ENABLE}&{KUGOU_ENABLE}
http-response ^https?:\/\/mobilead\.kugou\.com script-path=https://ws.wenn.in/main/Scripts/Kugou.js, requires-body=true, timeout=10, tag=酷狗_移动广告, enable={MEDIA_ENABLE}&{KUGOU_ENABLE}
http-response ^https?:\/\/gateway\.kugou\.com script-path=https://ws.wenn.in/main/Scripts/Kugou.js, requires-body=true, timeout=10, tag=酷狗_信息流, enable={MEDIA_ENABLE}&{KUGOU_ENABLE}
http-response ^https?:\/\/rich\.kuwo\.cn script-path=https://ws.wenn.in/main/Scripts/Kuwo.js, requires-body=true, timeout=10, tag=酷我_广告服务, enable={MEDIA_ENABLE}&{KUWO_ENABLE}
http-response ^https?:\/\/mobilead\.kuwo\.cn script-path=https://ws.wenn.in/main/Scripts/Kuwo.js, requires-body=true, timeout=10, tag=酷我_移动广告, enable={MEDIA_ENABLE}&{KUWO_ENABLE}
http-response ^https?:\/\/api\.youku\.com script-path=https://ws.wenn.in/main/Scripts/Youku.js, requires-body=true, timeout=10, tag=优酷开屏净化, enable={MEDIA_ENABLE}&{YOUKU_ENABLE}
http-response ^https?:\/\/iyes\.youku\.com script-path=https://ws.wenn.in/main/Scripts/Youku.js, requires-body=true, timeout=10, tag=优酷广告追踪, enable={MEDIA_ENABLE}&{YOUKU_ENABLE}
http-response ^https?:\/\/vali\.cp31\.ott\.cibntv\.net script-path=https://ws.wenn.in/main/Scripts/Youku.js, requires-body=true, timeout=10, tag=优酷视频广告, enable={MEDIA_ENABLE}&{YOUKU_ENABLE}
http-response ^https?:\/\/api5-normal-snkmer\.fqnovel\.com script-path=https://ws.wenn.in/main/Scripts/Fanqie.js, requires-body=true, timeout=10, tag=番茄小说信息流净化, enable={MEDIA_ENABLE}&{FANQIE_ENABLE}
http-response ^https?:\/\/ada\.fqnovel\.com script-path=https://ws.wenn.in/main/Scripts/Fanqie.js, requires-body=true, timeout=10, tag=番茄小说广告服务净化, enable={MEDIA_ENABLE}&{FANQIE_ENABLE}
http-response ^https?:\/\/log\.snssdk\.com url reject-200, enable={MEDIA_ENABLE}&{FANQIE_ENABLE}

[MitM]
hostname = %APPEND% ada.fqnovel.com, ads.kugou.com, api.youku.com, api5-normal-snkmer.fqnovel.com, gateway.kugou.com, iyes.youku.com, log.snssdk.com, mobilead.kugou.com, mobilead.kuwo.cn, rich.kuwo.cn, vali.cp31.ott.cibntv.net, bd-api.kuwo.cn, gateway.kugou.com, *-spclient.spotify.com, spclient.wg.spotify.com