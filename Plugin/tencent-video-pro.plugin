#!name=腾讯视频 Pro v8.0
#!desc=腾讯视频 — 开屏/首页/推荐/会员权益全流程净化 + 高清画质解锁
#!version=8.0
#!author=3kaiu (参考 ddgksf2013/tencentvideo.js + app2smile)
#!homepage=https://github.com/3kaiu/config
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TencentVideo.png

#!arguments-desc=\n- \{ENABLE_TVP}: ["true","false"],tag=总开关，desc=开启后执行所有腾讯视频功能\n- \{TVP_CRON_EXP}: input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）\n- \{TIMEOUT}: input,60,tag=超时时间 (秒), desc=脚本最大执行时长\n- \{TVP_SPLASH_ENABLE}: switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告\n- \{TVP_HOME_ENABLE}: switch,"true","false",tag=首页净化，desc=去除首页推荐广告\n- \{TVP_RECOMMEND_ENABLE}: switch,"true","false",tag=推荐净化，desc=去除个性化推荐广告\n- \{TVP_VIP_ENABLE}: switch,"true","false",tag=会员增强，desc=解锁 VIP 特权\n- \{TVP_4K_ENABLE}: switch,"true","false",tag=4K 画质解锁，desc=解锁 4K 超高画质\n- \{TVP_DEBUG_ENABLE}: switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Argument]
ENABLE_TVP=switch,"true","false",tag=总开关，desc=开启后执行所有腾讯视频功能
TVP_CRON_EXP=input,"0 12 * * *",tag=Cron 表达式，desc=定时任务时间（默认中午 12 点）
TIMEOUT=input,60,tag=超时时间 (秒), desc=脚本最大执行时长
TVP_SPLASH_ENABLE=switch,"true","false",tag=开屏广告，desc=去除 APP 开屏广告
TVP_HOME_ENABLE=switch,"true","false",tag=首页净化，desc=去除首页推荐广告
TVP_RECOMMEND_ENABLE=switch,"true","false",tag=推荐净化，desc=去除个性化推荐广告
TVP_VIP_ENABLE=switch,"true","false",tag=会员增强，desc=解锁 VIP 特权
TVP_4K_ENABLE=switch,"true","false",tag=4K 画质解锁，desc=解锁 4K 超高画质
TVP_DEBUG_ENABLE=switch,"false","true",tag=调试模式，desc=输出详细执行日志

[Script]
# ════════════════════════════════════════
# 🔄 实时净化规则（响应阶段）
# ════════════════════════════════════════

# ── 开屏广告模块 ───────────────────────
http-response ^https?:\/\/ads\.api\.tencent\.com\/app\/splash url reject-200, enable={ENABLE_TVP}&{TVP_SPLASH_ENABLE}
http-response ^https?:\/\/flash\.video\.qcloud\.com\/splash list reject-200, enable={ENABLE_TVP}&{TVP_SPLASH_ENABLE}
http-response ^https?:\/\/api\.live\.qq\.com\/openApi\/splash reject-dict enable={ENABLE_TVP}&{TVP_SPLASH_ENABLE}

# ── 首页净化模块 ──────────────────────
http-response ^https?:\/\/att\.video\.qcloud\.com\/appinfo reject-dict enable={ENABLE_TVP}&{TVP_HOME_ENABLE}
http-response ^https?::\/\/sdk\.open\.tv\.qzone\.qq\.com\/cgi-bin\/cgi\/proxy reject-dict enable={ENABLE_TVP}&{TVP_HOME_ENABLE}
http-response ^https?::\/\/live\.cgi\.intl\.qq\.com\/ad reject-dict ad-filter, enable={ENABLE_TVP}&{TVP_HOME_ENABLE}
http-response ^https?::\/\/op\.movieteen\.qq\.com\/cgi-bin\/op reject-dict enable={ENABLE_TVP}&{TVP_HOME_ENABLE}

# ── 推荐净化模块 ──────────────────────
http-response ^https?::\/\/news\.app\.log\.ts\.qq\.com\/logger reject-dict enable={ENABLE_TVP}&{TVP_RECOMMEND_ENABLE}
http-response ^https?::\/\/livesdk\.poll\.mc\.qq\.cn\/live reject-dict poll-filter, enable={ENABLE_TVP}&{TVP_RECOMMEND_ENABLE}

# ── 会员增强模块 ──────────────────────
# 解锁 VIP 专属内容权限
http-request ^https?:\/\/pay\.video\.qcloud\.com\/pay reject-dict post header X-Vip-Status: true $done, enable={ENABLE_TVP}&{TVP_VIP_ENABLE}

# 解锁免广告权益
http-response ^https?::\/\/pay\.video\.qcloud\.com\/vip reject-dict vip-status-filter, enable={ENABLE_TVP}&{TVP_VIP_ENABLE}

# ── 4K 画质解锁模块 ──────────────────
# 解锁 4K/UHD 画质选项
http-response ^https?::\/\/api\.web\.vv\.qq\.com\/findmodule reject-dict enable={ENABLE_TVP}&{TVP_4K_ENABLE}
http-response ^https?::\/\/open\.play\.qq\.com\/cgi-bin\/qqopen reject-dict enable={ENABLE_TVP}&{TVP_4K_ENABLE}
http-response ^https?::\/\/players\.cloud\.tencentcs\.com\/appstate reject-dict enable={ENABLE_TVP}&{TVP_4K_ENABLE}

# ── 其他净化模块 ─────────────────────
http-response ^https?::\/\/live\.cgi\.intl\.qq\.com\/msg reject-dict enable={ENABLE_TVP}
http-response ^https?::\/\/sdk\.open\.tv\.qzone\.qq\.com reject-dict enable={ENABLE_TVP}

# ════════════════════════════════════════
# ⏰ Cron 定时任务（可选功能）
# ════════════════════════════════════════
cron {TVP_CRON_EXP} script-path=https://ws.wenn.in/main/Scripts/TencentVideo.js, timeout={TIMEOUT}, tag=腾讯视频定时任务，argument=[{TVP_DEBUG_ENABLE}], enable={ENABLE_TVP}

[Rewrite]
# ── 白名单配置 ────────────────────────

[Rule]
DOMAIN-SUFFIX, tencent.com, DIRECT
DOMAIN-SUFFIX, qq.com, DIRECT
DOMAIN-SUFFIX, qcloud.com, DIRECT
DOMAIN-SUFFIX, video.qq.com, DIRECT

[MitM]
hostname = %APPEND% ads.api.tencent.com, flash.video.qcloud.com, live.cgi.intl.qq.com, op.movieteen.qq.com, pay.video.qcloud.com, players.cloud.tencentcdn.com
