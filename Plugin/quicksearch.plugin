#!name=QuickSearch
#!desc=Quick search tool
#!version=7.8
#!author=3kaiu (original: ajune0527)
#!homepage=https://github.com/3kaiu/config
#!openUrl=https://gitlab.com/lodepuly/vpn_tool/-/tree/master/Resource/Markdown/QuickSearch/README.md
#!icon=https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/Safari.png
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(978)

[Rewrite]
# Safari内输入快捷键+空格+搜索关键词快速指定搜索引擎搜索
# 先进入设置更改Safari默认搜索为DuckDuckGo

# bd = 百度搜索
# bdimg = 百度图片搜索
# gimg = 谷歌图片搜索
# b = Bing搜索
# wk = 维基搜索
# qm = 七麦搜索
# gh = GitHub搜索
# 无快捷键则默认使用Google搜索

request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bd\+([^&]+).+/i as urlMatch then redirect(302, "https://www.baidu.com/s?wd=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bdimg\+([^&]+).+/i as urlMatch then redirect(302, "https://image.baidu.com/search/index?tn=baiduimage&word=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gimg\+([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?&tbm=isch&q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=b\+([^&]+).+/i as urlMatch then redirect(302, "https://www.bing.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wk\+([^&]+).+/i as urlMatch then redirect(302, "https://zh.wikipedia.org/wiki/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=qm\+([^&]+).+/i as urlMatch then redirect(302, "https://www.qimai.cn/search/index/country/cn/search/${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gh\+([^&]+).+/i as urlMatch then redirect(302, "https://github.com/search?q=${urlMatch.1}")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+).+/i as urlMatch then redirect(302, "https://www.google.com/search?q=${urlMatch.1}")

[MitM]
hostname = %APPEND% duckduckgo.com
